---
// Fikri Bintang Purnomo — Portfolio Dynamic Theme Router
import { readThemeConfig } from '../lib/theme-store';

const queryTheme = Astro.url.searchParams.get('theme');
const siteCfg = await readThemeConfig(Astro.request.headers.get('cookie'));
const resolvedTheme = queryTheme || siteCfg.activeTheme;

if (resolvedTheme === 'midnight-portal') {
  return Astro.rewrite('/portfolio-backend');
}
