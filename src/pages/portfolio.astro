<style id="gsap-scroll-opt3-style">
  /* ============================================================
     FIXED ULTRA-SMOOTH IN-FLOW 3D FAN-OUT (NO PIN-SPACER GLITCH)
     ============================================================ */
  .process {
    position: relative !important;
    background: #071932 !important;
    color: #fff;
    padding: clamp(5.5rem, 8vw, 8.5rem) 0 clamp(6rem, 9vw, 9.5rem) !important;
    perspective: 1200px;
    overflow: hidden;
  }
  
  .process-header {
    max-width: 1400px;
    margin: 0 auto clamp(2rem, 3.5vw, 3rem);
    padding: 0 clamp(1.4rem, 2.5vw, 2.5rem);
    width: 100%;
    position: relative;
    z-index: 3;
  }

  .process-pipeline-wrap {
    max-width: 1400px;
    margin: 0 auto clamp(1.5rem, 2.5vw, 2.2rem);
    position: relative;
    padding: 0 clamp(1.4rem, 2.5vw, 2.5rem);
    width: 100%;
    z-index: 2;
  }
  .process-pipeline-svg {
    width: 100%;
    height: 32px;
    display: block;
    overflow: visible;
  }
  .pipe-track {
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 2;
    stroke-dasharray: 4 6;
  }
  .pipe-beam-active {
    stroke: #4F84D6;
    stroke-width: 2.5;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px #4F84D6);
  }

  .process-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.2rem, 2vw, 2.2rem);
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(1.4rem, 2.5vw, 2.5rem);
    width: 100%;
    perspective: 1200px;
    transform-style: preserve-3d;
    position: relative;
    z-index: 2;
  }

  /* Hardware GPU Accelerated 3D Cards */
  .p-card {
    border-radius: 26px;
    padding: clamp(2rem, 3vw, 2.6rem) clamp(1.4rem, 2vw, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 380px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    will-change: transform, opacity;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .p-card:hover {
    box-shadow: 0 26px 52px rgba(0, 0, 0, 0.55);
  }
  .p-card.p-blue:hover {
    border-color: rgba(169, 198, 232, 0.5);
    box-shadow: 0 26px 52px rgba(0, 0, 0, 0.55), 0 0 30px rgba(46, 107, 196, 0.45);
  }
  .p-card.p-ivory:hover {
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow: 0 26px 52px rgba(0, 0, 0, 0.55), 0 0 30px rgba(247, 244, 238, 0.25);
  }

  @media (max-width: 900px) {
    .process {
      padding: 4.5rem 1.25rem !important;
      perspective: none !important;
      overflow: visible !important;
    }
    .process-pipeline-wrap {
      display: none !important;
    }
    .process-cards {
      grid-template-columns: 1fr !important;
      gap: 1.25rem !important;
      padding: 0 !important;
      perspective: none !important;
      transform-style: flat !important;
    }
    .p-card {
      min-height: auto !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .about-text {
      font-size: 1.25rem !important;
      line-height: 1.55 !important;
    }
  }
</style>



