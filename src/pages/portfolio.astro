<script id="starfield-engine-script">
(function() {
  const LAYER_CONFIG = [
    // far — stardust halus, parallax paling lambat (kedalaman langit)
    { parallax: 0.22, sizeRange: [0.45, 0.85], opacityRange: [0.15, 0.40], twinkleChance: 0.15, densityShare: 0.50 },
    // mid — bintang medium
    { parallax: 0.55, sizeRange: [0.75, 1.30], opacityRange: [0.30, 0.65], twinkleChance: 0.35, densityShare: 0.35 },
    // near — "feature stars", aksen observatorium
    { parallax: 1.00, sizeRange: [1.20, 1.90], opacityRange: [0.50, 0.95], twinkleChance: 0.65, densityShare: 0.15 },
  ];

  function lerp(a, b, t) { return a + (b - a) * t; }

  function pickLayer() {
    const r = Math.random();
    let acc = 0;
    for (let i = 0; i < LAYER_CONFIG.length; i++) {
      acc += LAYER_CONFIG[i].densityShare;
      if (r <= acc) return i;
    }
    return LAYER_CONFIG.length - 1;
  }

  function pickColorForLayer(layerIndex) {
    if (layerIndex < 2) {
      return Math.random() < 0.82 ? '245, 249, 255' : '169, 198, 232';
    }
    const r = Math.random();
    if (r < 0.60) return '245, 249, 255';
    if (r < 0.85) return '169, 198, 232';
    return '79, 132, 214'; // radiant blue accent
  }

  function marginBiasedX(width) {
    const edge = Math.random() < 0.5 ? Math.random() * 0.22 : 1 - Math.random() * 0.22;
    const center = 0.25 + Math.random() * 0.50;
    return (Math.random() < 0.72 ? edge : center) * width;
  }

  function verticalFade(yRatio) {
    const fadeIn = Math.min(1, yRatio / 0.05);
    const fadeOut = Math.min(1, (1 - yRatio) / 0.08);
    return Math.max(0, Math.min(fadeIn, fadeOut));
  }

  function initStarfield() {
    const section = document.querySelector('.works');
    const canvas = document.querySelector('.works-starfield-canvas');
    if (!section || !canvas) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let stars = [];
    let visible = true;
    let sectionHeight = section.offsetHeight || 5000;

    function resizeCanvas() {
      const rect = canvas.getBoundingClientRect();
      width = rect.width || window.innerWidth;
      height = rect.height || window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function generate() {
      sectionHeight = section.offsetHeight || 5000;
      const densityPerThousandPx = 22; // Elegan & bertebaran cantik
      const totalCount = Math.round((sectionHeight / 1000) * densityPerThousandPx);
      stars = new Array(totalCount);
      for (let i = 0; i < totalCount; i++) {
        const layerIndex = pickLayer();
        const layer = LAYER_CONFIG[layerIndex];
        const worldY = Math.random() * sectionHeight;
        stars[i] = {
          x: marginBiasedX(width),
          worldY: worldY,
          yRatio: worldY / sectionHeight,
          layer: layerIndex,
          size: lerp(layer.sizeRange[0], layer.sizeRange[1], Math.random()),
          baseOpacity: lerp(layer.opacityRange[0], layer.opacityRange[1], Math.random()),
          color: pickColorForLayer(layerIndex),
          twinkles: Math.random() < layer.twinkleChance,
          phase: Math.random() * Math.PI * 2,
          freq: 0.9 + Math.random() * 1.8,
          driftPhase: Math.random() * Math.PI * 2,
          driftFreq: 0.10 + Math.random() * 0.12,
          driftAmp: 2 + Math.random() * 3.5,
        };
      }
    }

    function getScrollOffset() {
      const rect = section.getBoundingClientRect();
      const scrolledIntoSection = Math.max(0, -rect.top);
      const max = Math.max(0, section.offsetHeight - window.innerHeight);
      return Math.min(scrolledIntoSection, max);
    }

    function draw(time) {
      if (!visible) return;
      const cameraOffset = getScrollOffset();
      ctx.clearRect(0, 0, width, height);

      const tSec = (typeof time === 'number' && time > 0) ? (time > 1000 ? time / 1000 : time) : (performance.now() / 1000);

      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        const layer = LAYER_CONFIG[s.layer];
        const screenY = s.worldY - cameraOffset * layer.parallax;
        if (screenY < -20 || screenY > height + 20) continue; // Viewport Culling

        const drift = prefersReducedMotion ? 0 : Math.sin(tSec * s.driftFreq + s.driftPhase) * s.driftAmp;
        let opacity = s.baseOpacity * verticalFade(s.yRatio);
        if (!prefersReducedMotion && s.twinkles) {
          const tw = (Math.sin(tSec * s.freq + s.phase) + 1) / 2;
          opacity *= (0.60 + tw * 0.40);
        }

        ctx.beginPath();
        ctx.fillStyle = 'rgba(' + s.color + ', ' + opacity.toFixed(3) + ')';
        ctx.arc(s.x + drift, screenY, s.size, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    resizeCanvas();
    generate();

    if (prefersReducedMotion) {
      draw(0);
    } else if (window.gsap && window.gsap.ticker) {
      window.gsap.ticker.add(draw);
    } else {
      let rafId;
      function loop() {
        draw(performance.now() / 1000);
        rafId = requestAnimationFrame(loop);
      }
      rafId = requestAnimationFrame(loop);
    }

    window.addEventListener('resize', () => {
      resizeCanvas();
      generate();
    }, { passive: true });

    if (window.ResizeObserver) {
      const ro = new ResizeObserver(() => {
        sectionHeight = section.offsetHeight || 5000;
      });
      ro.observe(section);
    }

    if (window.IntersectionObserver) {
      const io = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
      }, { threshold: 0 });
      io.observe(section);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStarfield);
  } else {
    initStarfield();
  }
})();
</script>












<script id="gsap-scroll-opt3-script">
window.addEventListener('load', function() {
  if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

  const section = document.getElementById('proses');
  const cards = document.querySelectorAll('#proses .process-cards .p-card');
  const beam = document.getElementById('processPipelineBeam');

  if (!section || cards.length < 4) return;

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) return;

  const isDesktop = window.innerWidth > 900;
  if (!isDesktop) return;

  // Single ultra-responsive timeline — IN-FLOW (No Pin Glitch, No Header Cutoff, No Bottom Void)
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: section,
      start: "top 80%",       // Mulai merekah saat section masuk layar
      end: "center 52%",      // Selesai merekah sempurna saat di tengah pandangan
      scrub: 0.6,             // Mulus, renyah, dan terkontrol 1:1 mengikuti jari
      invalidateOnRefresh: true,
    }
  });

  // Smooth 3D Fan-out Unfolding
  tl.fromTo(cards[0],
    { xPercent: 120, y: 35, rotationZ: -10, scale: 0.93, opacity: 0.6, force3D: true },
    { xPercent: 0, y: 0, rotationZ: 0, scale: 1, opacity: 1, ease: "power1.out", force3D: true },
    0
  );
  tl.fromTo(cards[1],
    { xPercent: 40, y: 15, rotationZ: -3.5, scale: 0.96, opacity: 0.85, force3D: true },
    { xPercent: 0, y: 0, rotationZ: 0, scale: 1, opacity: 1, ease: "power1.out", force3D: true },
    0
  );
  tl.fromTo(cards[2],
    { xPercent: -40, y: 15, rotationZ: 3.5, scale: 0.96, opacity: 0.85, force3D: true },
    { xPercent: 0, y: 0, rotationZ: 0, scale: 1, opacity: 1, ease: "power1.out", force3D: true },
    0
  );
  tl.fromTo(cards[3],
    { xPercent: -120, y: 35, rotationZ: 10, scale: 0.93, opacity: 0.6, force3D: true },
    { xPercent: 0, y: 0, rotationZ: 0, scale: 1, opacity: 1, ease: "power1.out", force3D: true },
    0
  );

  // Synchronous Laser Pipeline Beam
  if (beam) {
    tl.fromTo(beam,
      { strokeDasharray: 1200, strokeDashoffset: 1200 },
      { strokeDashoffset: 0, ease: "power1.out" },
      0
    );
  }
});
</script>



<script id="about-kinetic-script">
window.addEventListener('load', function() {
  if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

  const aboutEl = document.getElementById('aboutText');
  if (!aboutEl) return;

  // Split words into <span class="w">
  const rawText = aboutEl.innerText.trim();
  const words = rawText.split(/\s+/);
  aboutEl.innerHTML = words.map(w => `<span class="w">${w}</span>`).join(' ');

  const wordSpans = aboutEl.querySelectorAll('.w');
  if (wordSpans.length === 0) return;

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    wordSpans.forEach(w => w.classList.add('on'));
    return;
  }

  // Kinetic Reading Flow Scrubbing
  gsap.fromTo(wordSpans, 
    { color: 'rgba(11, 37, 69, 0.22)', opacity: 0.35 },
    {
      color: '#0B2545',
      opacity: 1,
      stagger: 0.04,
      ease: 'none',
      scrollTrigger: {
        trigger: aboutEl,
        start: 'top 75%',
        end: 'bottom 45%',
        scrub: 0.5,
      }
    }
  );
});
</script>







