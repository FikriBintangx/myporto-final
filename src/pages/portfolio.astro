<script id="dual-dossier-folder-script">
(function() {
  function initDualFolderStack() {
    if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined") {
      setTimeout(initDualFolderStack, 100);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    if (!document.getElementById('folderScene')) return;

    const cardsLeft = [
      document.getElementById('cardL1'),
      document.getElementById('cardL2'),
      document.getElementById('cardL3'),
      document.getElementById('cardL4'),
      document.getElementById('cardL5'),
      document.getElementById('cardL6')
    ].filter(Boolean);

    const cardsRight = [
      document.getElementById('cardR1'),
      document.getElementById('cardR2'),
      document.getElementById('cardR3'),
      document.getElementById('cardR4')
    ].filter(Boolean);

    const hudProgress = document.getElementById('hudProgress');
    const stage = document.querySelector('.dual-folder-stage');

    const isMobile = window.innerWidth <= 900;

    // Mobile calibrated offsets: stops below the top tabs!
    const leftYOffsets = isMobile 
      ? [-135, -110, -85, -60, -35, -10]
      : [-310, -250, -190, -130, -70, -10];
    const leftRotations = isMobile
      ? [-0.8, 0.7, -0.6, 0.7, -0.5, 0.3]
      : [-1.5, 1.3, -1.1, 1.4, -0.9, 0.6];

    const rightYOffsets = isMobile 
      ? [-130, -90, -50, -10]
      : [-280, -190, -100, -10];
    const rightRotations = isMobile
      ? [0.7, -0.8, 0.5, -0.3]
      : [1.2, -1.3, 0.9, -0.6];

    // Initial Placement: Rest inside pocket
    cardsLeft.forEach((card, i) => {
      gsap.set(card, {
        y: (isMobile ? 55 : 85) + (i * (isMobile ? 4 : 6)),
        scale: 0.95 + (i * 0.01),
        rotation: 0,
        opacity: 1,
        zIndex: 10 + i,
        boxShadow: '0 8px 24px -4px rgba(11, 37, 69, 0.10)'
      });
    });

    cardsRight.forEach((card, i) => {
      gsap.set(card, {
        y: (isMobile ? 55 : 85) + (i * (isMobile ? 5 : 8)),
        scale: 0.95 + (i * 0.012),
        rotation: 0,
        opacity: 1,
        zIndex: 10 + i,
        boxShadow: '0 8px 24px -4px rgba(11, 37, 69, 0.10)'
      });
    });

    // Mobile Dossier Selector function
    window.selectMobileDossier = function(folder, shouldScroll = true) {
      const s = document.querySelector('.dual-folder-stage');
      const btnL = document.getElementById('btnTabAcademia');
      const btnR = document.getElementById('btnTabCareer');
      if (!s) return;

      s.setAttribute('data-active-dossier', folder);
      if (folder === 'left') {
        if (btnL) btnL.classList.add('is-active');
        if (btnR) btnR.classList.remove('is-active');
        if (shouldScroll && window.innerWidth <= 900) {
          jumpProgress(0.12);
        }
      } else {
        if (btnR) btnR.classList.add('is-active');
        if (btnL) btnL.classList.remove('is-active');
        if (shouldScroll && window.innerWidth <= 900) {
          jumpProgress(0.58);
        }
      }
    };

    // Master ScrollTrigger Timeline
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#folderScene',
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.75,
        onUpdate: (self) => {
          const p = self.progress;
          if (hudProgress) {
            hudProgress.textContent = `KLIK KARTU MANA SAJA UNTUK MENGANGKAT · PROGRESS ${(p * 100).toFixed(0)}%`;
          }

          if (window.innerWidth <= 900 && stage) {
            const cur = stage.getAttribute('data-active-dossier');
            if (p < 0.48 && cur !== 'left') {
              window.selectMobileDossier('left', false);
            } else if (p >= 0.48 && cur !== 'right') {
              window.selectMobileDossier('right', false);
            }
          }
        }
      }
    });

    // Animate Left Deck (6 Cards)
    cardsLeft.forEach((card, i) => {
      const stepStart = i / cardsLeft.length;
      const stepDur = 0.85 / cardsLeft.length;

      tl.to(card, {
        y: leftYOffsets[i],
        scale: 1,
        rotation: leftRotations[i],
        opacity: 1,
        boxShadow: '0 20px 45px -8px rgba(11, 37, 69, 0.18)',
        ease: 'power2.out',
        duration: stepDur
      }, stepStart);
    });

    // Animate Right Deck (4 Cards)
    cardsRight.forEach((card, i) => {
      const stepStart = i / cardsRight.length;
      const stepDur = 0.85 / cardsRight.length;

      tl.to(card, {
        y: rightYOffsets[i],
        scale: 1,
        rotation: rightRotations[i],
        opacity: 1,
        boxShadow: '0 20px 45px -8px rgba(11, 37, 69, 0.18)',
        ease: 'power2.out',
        duration: stepDur
      }, stepStart);
    });

    // CLICK-TO-ELEVATE INTERACTION
    const allDossierCards = [...cardsLeft, ...cardsRight];

    allDossierCards.forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('a')) return;

        const isAlreadyElevated = card.classList.contains('is-elevated');
        allDossierCards.forEach(c => c.classList.remove('is-elevated'));

        if (!isAlreadyElevated) {
          card.classList.add('is-elevated');
          if (hudProgress) {
            hudProgress.textContent = `DOKUMEN TERANGKAT KE ATAS · KLIK LAGI UNTUK MENURUNKAN`;
          }
        }
      });
    });

    // Dismiss elevated card on backdrop/stage click
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.dossier-card') && !e.target.closest('.preview-controls') && !e.target.closest('.mobile-dossier-nav-wrapper')) {
        allDossierCards.forEach(c => c.classList.remove('is-elevated'));
      }
    });

    window.jumpProgress = function(pct) {
      const scene = document.getElementById('folderScene');
      if (!scene) return;
      const rect = scene.getBoundingClientRect();
      const sceneTop = rect.top + window.scrollY;
      const sceneH = scene.offsetHeight - window.innerHeight;
      window.scrollTo({ top: sceneTop + (pct * sceneH), behavior: 'smooth' });
    };
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDualFolderStack);
  } else {
    initDualFolderStack();
  }
})();
</script>

