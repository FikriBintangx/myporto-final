        </a>
      `).join('');

      const totalL = langs.reduce((s, [, c]) => s + c, 0) || 1;
      const barCols = 26;
      const header = `┌─ LANGUAGE_DISTRIBUTION // @FikriBintangx ─────────────────────┐\n`;
      const rows = langs.map(([lang, cnt]) => {
        const pct = Math.round((cnt / totalL) * 100);
        const filled = Math.max(1, Math.round((pct / 100) * barCols));
        const namePad = lang.padEnd(11, ' ');
        const onBar = '█'.repeat(Math.max(0, filled - 1));
        const tipBar = '▓';
        const offBar = '░'.repeat(Math.max(0, barCols - filled));
        const pctStr = String(pct).padStart(2, ' ') + '%';
        const cntStr = String(cnt).padStart(2, '0');
        return `│ <span class="l-name">${namePad}</span> │ <span class="l-bar-on">${onBar}</span><span class="l-bar-hi">${tipBar}</span><span class="l-bar-off">${offBar}</span> │ <span class="l-pct">${pctStr}</span> (${cntStr}) │`;
      }).join('\n');
      const footer = `\n└─ TOTAL_ANALYZED: ${totalL} REPOSITORIES ───────────────────────────┘`;
      langListEl.innerHTML = `<pre class="gh-ascii-langs">${header}${rows}${footer}</pre>`;
    }

    // Fetch synced verified snapshot + background live refresh for @FikriBintangx
    (async function loadLiveGitHub() {
      try {
        const snapRes = await fetch('/data/gh-stats-snapshot.json');
        if (snapRes.ok) {
          const snap = await snapRes.json();
          if (typeof snap.repoCount === 'number') repoCountEl.textContent = snap.repoCount;
          if (typeof snap.total === 'number') contribTotalEl.textContent = snap.total.toLocaleString();
          if (Array.isArray(snap.days) && snap.days.length) {
            contribDays = snap.days.map(x => ({ date: x.d, count: x.c, level: x.l }));
          }
          if (Array.isArray(snap.topRepos) && Array.isArray(snap.langs)) {
            renderReposAndLangs(snap.topRepos, snap.langs);
          }
        }
      } catch (_) {}

      try {
        const [uRes, rRes] = await Promise.all([
          fetch(`https://api.github.com/users/${GH_USER}`),
          fetch(`https://api.github.com/users/${GH_USER}/repos?per_page=100&sort=updated`)
        ]);
        if (uRes.ok) {
          const u = await uRes.json();
          if (typeof u.public_repos === 'number') repoCountEl.textContent = u.public_repos;
        }
        if (rRes.ok) {
          const repos = await rRes.json();
          if (Array.isArray(repos) && repos.length) {
            const topRepos = repos.filter(r => !r.fork).slice(0, 6);
            const counts = {};
            repos.forEach(r => { if (r.language) counts[r.language] = (counts[r.language] || 0) + 1; });
            const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 6);
            renderReposAndLangs(topRepos, sorted);
          }
        }
      } catch (_) {}
    })();

