    // Generate deterministic fallback 52x7 grid immediately, then replace with live API data
    function buildFallbackContribs() {
      const days = [];
      const now = new Date();
      let seed = 7331;
      const rand = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
      for (let i = 363; i >= 0; i--) {
        const d = new Date(now - i * 86400000);
        const r = rand();
        const count = r > 0.72 ? Math.floor(rand() * 9) + 2 : (r > 0.45 ? Math.floor(rand() * 3) + 1 : 0);
        days.push({ date: d.toISOString().slice(0, 10), count, level: count === 0 ? 0 : count < 3 ? 1 : count < 6 ? 2 : count < 9 ? 3 : 4 });
      }
      return days;
    }

    let contribDays = buildFallbackContribs();
    let yaw = -0.62;
    let pitch = 0.56;
    let targetYaw = yaw;
    let isDragging = false;
    let lastX = 0;
    let projectedBars = [];
    let hoveredBar = null;
    let animPhase = 0;

    function resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function project3D(gx, gy, gz, w, h) {
      const cosY = Math.cos(yaw), sinY = Math.sin(yaw);
      const cosP = Math.cos(pitch), sinP = Math.sin(pitch);
      const rx = gx * cosY - gz * sinY;
      const rz = gx * sinY + gz * cosY;
      const ry = gy * cosP - rz * sinP;
      const depth = gy * sinP + rz * cosP;
      const scale = Math.min(w / 56, 13.5);
      return { x: w * 0.5 + rx * scale, y: h * 0.58 - ry * scale, depth, scale };
    }

    const levelColorsDark = [
      { top: '#11134a', left: '#0b0c34', right: '#070826' },
      { top: '#1f2bff', left: '#151ec4', right: '#0e1594' },
      { top: '#4353ff', left: '#2735db', right: '#1923a8' },
      { top: '#7888ff', left: '#4c5ce6', right: '#323fb8' },
      { top: '#d8e0ff', left: '#8d9cff', right: '#5a68e6' }
    ];
    const levelColorsLight = [
      { top: '#e4e8f7', left: '#d4dbf0', right: '#c2cce8' },
      { top: '#94a3ff', left: '#7587f5', right: '#5b6de0' },
      { top: '#4f60ff', left: '#3748e8', right: '#2534c9' },
      { top: '#1f2bff', left: '#1620d4', right: '#0f17a8' },
      { top: '#07092b', left: '#101552', right: '#1a217a' }
    ];

    function draw3DSkyline() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const w = rect.width, h = rect.height;
      ctx.clearRect(0, 0, w, h);

      if (!isDragging) {
        animPhase += 0.006;
        targetYaw += Math.sin(animPhase) * 0.00035;
      }
      yaw += (targetYaw - yaw) * 0.1;

      const weeks = Math.ceil(contribDays.length / 7);
      const bars = [];
      for (let i = 0; i < contribDays.length; i++) {
        const wk = Math.floor(i / 7) - weeks / 2;
        const dy = (i % 7) - 3;
        const item = contribDays[i];
        const barH = 0.25 + Math.min(item.count, 14) * 0.42;
        const p = project3D(wk * 0.92, barH * 0.5, dy * 1.15, w, h);
        bars.push({ wk, dy, barH, item, depth: p.depth });
      }
      bars.sort((a, b) => a.depth - b.depth);

      projectedBars = [];
      const half = 0.36;

      for (const b of bars) {
        const cx = b.wk * 0.92;
        const cz = b.dy * 1.15;
        const y0 = 0;
        const y1 = b.barH;
        const isHov = hoveredBar && hoveredBar.item.date === b.item.date;
        const light = isLightMode();
        const palette = light ? levelColorsLight : levelColorsDark;
        const col = isHov
          ? (light ? { top: '#07092b', left: '#1f2bff', right: '#141fd6' } : { top: '#ffffff', left: '#a8b4ff', right: '#6b7bff' })
          : palette[Math.min(4, b.item.level || 0)];

        const p000 = project3D(cx - half, y0, cz - half, w, h);
        const p100 = project3D(cx + half, y0, cz - half, w, h);
        const p101 = project3D(cx + half, y0, cz + half, w, h);
        const p001 = project3D(cx - half, y0, cz + half, w, h);

        const p010 = project3D(cx - half, y1, cz - half, w, h);
        const p110 = project3D(cx + half, y1, cz - half, w, h);
        const p111 = project3D(cx + half, y1, cz + half, w, h);
        const p011 = project3D(cx - half, y1, cz + half, w, h);

        const poly = (pts, fill) => {
          ctx.beginPath();
          ctx.moveTo(pts[0].x, pts[0].y);
          for (let k = 1; k < pts.length; k++) ctx.lineTo(pts[k].x, pts[k].y);
          ctx.closePath();
          ctx.fillStyle = fill;
          ctx.fill();
        };

        // Visible side faces based on yaw orientation
        if (Math.sin(yaw) <= 0) poly([p100, p101, p111, p110], col.right);
        else poly([p000, p001, p011, p010], col.right);

        if (Math.cos(yaw) >= 0) poly([p001, p101, p111, p011], col.left);
        else poly([p000, p100, p110, p010], col.left);

        poly([p010, p110, p111, p011], col.top);

        projectedBars.push({
          cx: (p010.x + p111.x) * 0.5,
          cy: (p010.y + p111.y) * 0.5,
          item: b.item
        });
      }
      requestAnimationFrame(draw3DSkyline);
    }

    canvas.addEventListener('pointerdown', (e) => { isDragging = true; lastX = e.clientX; });
    window.addEventListener('pointerup', () => { isDragging = false; });
    window.addEventListener('pointermove', (e) => {
      if (isDragging) {
        targetYaw += (e.clientX - lastX) * 0.008;
        lastX = e.clientX;
      }
    });
    canvas.addEventListener('mousemove', (e) => {
      if (isDragging) return;
      const r = canvas.getBoundingClientRect();
      const mx = e.clientX - r.left, my = e.clientY - r.top;
      let best = null, bestD = 16;
      for (const b of projectedBars) {
        const d = Math.hypot(b.cx - mx, b.cy - my);
        if (d < bestD) { bestD = d; best = b; }
      }
      hoveredBar = best;
      if (best) {
        tipEl.textContent = `${best.item.date} · ${best.item.count} contrib${best.item.count === 1 ? '' : 's'}`;
        tipEl.style.left = `${Math.min(r.width - 170, Math.max(8, mx + 12))}px`;
