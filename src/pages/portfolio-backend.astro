---
import { readThemeConfig } from '../lib/theme-store';
const siteCfg = await readThemeConfig(Astro.request.headers.get('cookie'));
const siteCfgJson = JSON.stringify(siteCfg);
---
<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://fikribintang.web.id/portfolio" />
  <title>Fikri Bintang Purnomo — Backend Developer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <!-- Mandatory Tri-Engine Motion Stack: Lenis + GSAP + ScrollTrigger + Anime.js -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.20/dist/lenis.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/animejs@3.2.2/lib/anime.min.js"></script>
  <style is:global>
    :root {
      --bg: #040424;
      --bg-sidebar: #03031c;
      --bg-card: #080834;
      --bg-card-hover: #0d0d47;
      --bg-deep: #020218;
      --cobalt: #1f2bff;
      --cobalt-hover: #3541ff;
      --on-cobalt: #ffffff;
      --text: #f4f5ff;
      --text-muted: #b3b7dc;
      --text-dim: #6e73a6;
      --line: rgba(160, 168, 255, 0.14);
      --line-strong: rgba(160, 168, 255, 0.28);
      --white: #ffffff;
      --cond: 'Barlow Condensed', sans-serif;
      --sans: 'Inter', -apple-system, sans-serif;
      --mono: 'IBM Plex Mono', ui-monospace, monospace;
    }

    html.light {
      --bg: #f4f6fb;
      --bg-sidebar: #ebeff8;
      --bg-card: #ffffff;
      --bg-card-hover: #f8faff;
      --bg-deep: #eef2fb;
      --cobalt: #1f2bff;
      --cobalt-hover: #141fd6;
      --on-cobalt: #ffffff;
      --text: #07092b;
      --text-muted: #3f456e;
      --text-dim: #646b96;
      --line: rgba(15, 23, 84, 0.13);
      --line-strong: rgba(15, 23, 84, 0.26);
      --white: #07092b;
    }

    /* Light Mode targeted refinements */
    html.light .sidebar {
      background:
        radial-gradient(circle at 20% 65%, rgba(31, 43, 255, 0.07), transparent 55%),
        var(--bg-sidebar);
    }
    html.light .sb-cta { background: var(--text); color: #ffffff; }
    html.light .sb-group-tag { background: var(--text); color: #ffffff; }
    html.light .btn-cobalt,
    html.light .lang-btn.active,
    html.light .gh-tab.active,
    html.light .exp-now,
    html.light .preview-bar a.active,
    html.light .avatar-modal-btn.active { color: var(--on-cobalt); }
    html.light .filter-btn.active { background: var(--text); color: #ffffff; border-color: var(--text); }
    html.light .sb-min-btn,
    html.light .rail-toggle,
    html.light .lang-toggle,
    html.light .theme-btn,
    html.light .avatar-modal-btn { background: #ffffff; }
    html.light .sb-needle { background: var(--cobalt); box-shadow: 0 0 10px rgba(31, 43, 255, 0.55); }
    html.light .sb-needle::before { background: var(--cobalt); }
    html.light .hero-video-bg { opacity: 0.42; filter: contrast(1.02) brightness(1.08) saturate(0.95); }
    html.light .hero-video-scrim {
      background:
        radial-gradient(circle at 75% 25%, rgba(31, 43, 255, 0.08), transparent 55%),
        linear-gradient(180deg, rgba(244, 246, 251, 0.52) 0%, rgba(244, 246, 251, 0.84) 60%, #f4f6fb 100%);
    }
    html.light .dither-strip {
      background:
        radial-gradient(rgba(31, 43, 255, 0.16) 1px, transparent 1px),
        linear-gradient(90deg, rgba(31, 43, 255, 0.08), rgba(255, 255, 255, 0.92) 55%, rgba(31, 43, 255, 0.06));
      background-size: 6px 6px, 100% 100%;
    }
    html.light .gh-panel,
    html.light .gh-stage,
    html.light .ascii-art-box,
    html.light .svc-preview,
    html.light .paper-ascii,
    html.light .rail-telemetry,
    html.light .sb-avatar { background: #ffffff; }
    html.light .gh-stage { background: radial-gradient(circle at 50% 60%, rgba(31, 43, 255, 0.06), transparent 68%), #f8faff; }
    html.light .gh-repo-card { background: #f8faff; }
    html.light .gh-repo-card:hover { border-color: var(--cobalt); background: rgba(31, 43, 255, 0.05); }
    html.light .gh-repo-name em,
    html.light .gh-repo-lang,
    html.light .paper-cta,
    html.light .exp-ascii-meter { color: var(--cobalt); }
    html.light .gh-ascii-langs .l-bar-on { color: var(--cobalt); text-shadow: none; }
    html.light .gh-ascii-langs .l-bar-hi { color: #07092b; }
    html.light .gh-ascii-langs .l-bar-off { color: rgba(15, 23, 84, 0.16); }
    html.light .gh-ascii-langs .l-pct { color: #15803d; }
    html.light .gh-tip { background: rgba(7, 9, 43, 0.92); color: #ffffff; }
    html.light .svc-proto { background: rgba(31, 43, 255, 0.09); border-color: rgba(31, 43, 255, 0.25); color: var(--cobalt); }
    html.light .ascii-art-tag,
    html.light .svc-preview-badge { background: rgba(255, 255, 255, 0.92); color: var(--cobalt); }
    html.light .paper-ascii { color: var(--cobalt); text-shadow: none; }
    html.light .paper-card:hover .paper-ascii { color: #07092b; }
    html.light .exp-track-rail { background-image: radial-gradient(circle, rgba(15, 23, 84, 0.22) 1.5px, transparent 1.8px); }
    html.light .exp-track-fill { background-image: radial-gradient(circle, #1f2bff 1.7px, rgba(31, 43, 255, 0.6) 2.4px, transparent 2.8px); filter: none; }
    html.light .exp-track-pulse { background: var(--cobalt); box-shadow: 0 0 10px rgba(31, 43, 255, 0.7); }
    html.light .exp-row.is-lit::before,
    html.light .exp-row.is-now::before { color: var(--cobalt); text-shadow: none; }
    html.light .exp-row:hover { background: rgba(31, 43, 255, 0.05); }
    html.light .rail-radar-card,
    html.light .rail-radar-canvas-wrap { background: #ffffff; border-color: var(--line-strong); box-shadow: 0 8px 24px rgba(7, 9, 43, 0.06); }
    html.light .rail-skill-table { border-top-color: var(--line); color: var(--text-muted); }
    html.light .rail-skill-head { color: var(--text); }
    html.light .rail-skill-bar-track { background: rgba(15, 23, 84, 0.08); }
    html.light .rail-radar-foot { background: #f8faff; border-top-color: var(--line); color: var(--text); }
    html.light .rail-tab-btn { background: #f1f5fb; border-color: var(--line); color: var(--text-muted); }
    html.light .rail-tab-btn.active { background: var(--cobalt); border-color: var(--cobalt); color: #ffffff; }
    html.light .rail-pill-btn { background: #ffffff; border-color: var(--line-strong); color: var(--text-muted); }
    html.light .rail-pill-btn:hover { border-color: var(--cobalt); color: var(--cobalt); background: rgba(31, 43, 255, 0.05); }
    html.light .rail-bento-item { background: #ffffff; border-color: var(--line-strong); }
    html.light .rail-bento-val { color: var(--text); }
    html.light .rail-bento-val.ok { color: #15803d; }
    html.light .rail-panel-head { border-bottom-color: var(--line); }
    html.light .rail-scroll-track { background: rgba(15, 23, 84, 0.12); }
    html.light .preview-bar { background: rgba(255, 255, 255, 0.94); box-shadow: 0 10px 28px rgba(7, 9, 43, 0.12); }
    html.light .avatar-modal { background: rgba(244, 246, 251, 0.84); }
    html.light .avatar-modal-card { background: #ffffff; box-shadow: 0 24px 60px rgba(7, 9, 43, 0.18); }

    .theme-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--line);
      color: var(--text-muted);
      width: 28px;
      height: 28px;
      border-radius: 7px;
      cursor: pointer;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease, transform 0.14s ease;
    }
    .theme-btn:hover {
      color: var(--white);
      border-color: rgba(56, 189, 248, 0.55);
      background: rgba(56, 189, 248, 0.1);
    }
    .theme-btn:active { transform: scale(0.94); }
    .theme-btn svg, .sb-min-btn svg { width: 14px; height: 14px; display: block; }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: var(--bg); color: var(--text); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
    body { min-height: 100vh; line-height: 1.6; overflow-x: hidden; background: var(--bg); }
    .mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
    .cond { font-family: var(--cond); }
    a { color: inherit; text-decoration: none; }

    /* GSAP Per-Kata Mask */
    .word-mask { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.08em; margin-bottom: -0.08em; }
    .word-inner { display: inline-block; will-change: transform, opacity; }

    /* 3-Zone Portal Shell */
    .shell {
      display: grid;
      grid-template-columns: 268px 1fr 56px;
      min-height: 100vh;
      transition: grid-template-columns 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .shell.sb-min { grid-template-columns: 168px 1fr 56px; }
    .shell.rail-open { grid-template-columns: 268px 1fr 340px; }
    .shell.sb-min.rail-open { grid-template-columns: 168px 1fr 340px; }

    @media (max-width: 1280px) {
      .shell.rail-open, .shell.sb-min.rail-open { grid-template-columns: 268px 1fr 56px; }
      .shell.sb-min.rail-open { grid-template-columns: 168px 1fr 56px; }
      .shell.rail-open .right-rail {
        position: fixed; right: 0; top: 0; width: 340px; z-index: 90;
        box-shadow: -18px 0 48px rgba(0, 0, 0, 0.78);
      }
    }

    /* LEFT SIDEBAR */
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      background:
        radial-gradient(circle at 20% 65%, rgba(31, 43, 255, 0.14), transparent 55%),
        var(--bg-sidebar);
      border-right: 1px solid var(--line);
      padding: 20px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 30;
      overflow: hidden;
    }
    .sb-min-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--line);
      color: var(--text-muted);
      width: 28px;
      height: 28px;
      border-radius: 7px;
      cursor: pointer;
      display: grid;
      place-items: center;
      font-family: var(--mono);
      font-size: 11px;
      flex-shrink: 0;
      transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease, transform 0.14s ease;
    }
    .sb-min-btn:hover {
      color: var(--white);
      border-color: rgba(56, 189, 248, 0.55);
      background: rgba(56, 189, 248, 0.1);
    }
    .sb-min-btn:active { transform: scale(0.94); }
    .sb-controls-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 5px 6px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.028);
      border: 1px solid var(--line);
    }
    html.light .sb-controls-bar {
      background: rgba(15, 23, 84, 0.035);
      border-color: var(--line-strong);
    }
    .sb-controls-actions {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .sb-min-bar {
      display: none; align-items: center; justify-content: space-between;
      padding-bottom: 10px; border-bottom: 1px dotted var(--line);
      font-family: var(--mono); font-size: 10px; color: var(--text-dim); letter-spacing: 0.08em;
    }
    .shell.sb-min .sb-brand-row,
    .shell.sb-min .sb-controls-bar,
    .shell.sb-min .sb-cta,
    .shell.sb-min .sb-group-tag,
    .shell.sb-min .sb-ext-item,
    .shell.sb-min .sb-foot { display: none; }
    .shell.sb-min .sb-min-bar { display: flex; }
    .shell.sb-min .sb-ruler-wrap { gap: 4px; }
    .shell.sb-min .sb-nav a { font-size: 13px; padding: 8px 4px; }
    .shell.sb-min .sb-ico { display: none; }
    .sb-top { position: relative; display: flex; flex-direction: column; gap: 18px; }
    .sb-ruler-wrap {
      position: relative;
      padding-left: 22px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .sb-ruler-canvas {
      position: absolute;
      left: 0;
      top: 0;
      width: 16px;
      height: 100%;
      pointer-events: none;
    }
    .sb-needle {
      position: absolute;
      left: 0;
      top: 0;
      width: 16px;
      height: 2px;
      background: var(--white);
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.85), 0 0 18px rgba(31, 43, 255, 0.9);
      pointer-events: none;
      will-change: transform;
      z-index: 6;
    }
    .sb-needle::before {
      content: '';
      position: absolute;
      left: 0;
      top: -11px;
      width: 2px;
      height: 24px;
      background: var(--white);
      border-radius: 1px;
    }
    .sb-ruler-pct {
      font-family: var(--mono);
      font-size: 10px;
      color: var(--text-dim);
      letter-spacing: 0.08em;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 8px;
      border-top: 1px dotted var(--line);
    }
    .sb-ruler-pct b { color: var(--white); font-weight: 600; }
    .sb-brand-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .sb-brand { display: flex; align-items: center; gap: 12px; }
    .lang-toggle {
      display: inline-flex;
      align-items: center;
      padding: 2px;
      gap: 2px;
      background: rgba(2, 2, 24, 0.72);
      border: 1px solid var(--line);
      border-radius: 7px;
      font-family: var(--mono);
      font-size: 10px;
      flex-shrink: 0;
    }
    .lang-btn {
      background: transparent;
      border: none;
      color: var(--text-dim);
      padding: 4px 10px;
      border-radius: 5px;
      cursor: pointer;
      font-family: inherit;
      font-size: inherit;
      font-weight: 600;
      letter-spacing: 0.06em;
      transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
    }
    .lang-btn:hover { color: var(--white); }
    .lang-btn.active {
      background: var(--cobalt);
      color: var(--on-cobalt);
      box-shadow: 0 2px 8px rgba(31, 43, 255, 0.42);
    }
    .mob-lang-wrap { display: none; justify-content: flex-end; margin-bottom: 12px; }
    .sb-avatar {
      width: 52px; height: 52px; border-radius: 4px; background: #020218;
      overflow: hidden; border: 1px solid var(--line-strong); flex-shrink: 0;
      cursor: zoom-in; transition: border-color 0.16s ease, transform 0.16s ease;
    }
    .sb-avatar:hover { border-color: var(--white); transform: scale(1.05); }
    .sb-avatar canvas { width: 100%; height: 100%; display: block; image-rendering: pixelated; }

    /* Avatar Zoom Lightbox Modal */
    .avatar-modal {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(2, 2, 20, 0.86); backdrop-filter: blur(12px);
      display: none; align-items: center; justify-content: center; padding: 24px;
    }
    .avatar-modal.open { display: flex; }
    .avatar-modal-card {
      background: #05051f; border: 1px solid var(--line-strong); border-radius: 6px;
      padding: 16px; max-width: 400px; width: 100%;
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.78);
    }
    .avatar-modal-top {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 12px; font-family: var(--mono); font-size: 11px; color: var(--text-muted);
    }
    .avatar-modal-actions { display: flex; gap: 6px; }
    .avatar-modal-btn {
      background: #020218; border: 1px solid var(--line-strong); color: var(--text-muted);
      padding: 3px 9px; border-radius: 3px; font-family: var(--mono); font-size: 10.5px; cursor: pointer;
    }
    .avatar-modal-btn:hover, .avatar-modal-btn.active { background: var(--cobalt); border-color: var(--cobalt); color: var(--white); }
    .avatar-modal-stage {
      position: relative; width: 100%; aspect-ratio: 1 / 1;
      border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: #020218;
    }
    .avatar-modal-stage canvas, .avatar-modal-stage img {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; display: block;
    }
    .avatar-modal-stage canvas { image-rendering: pixelated; z-index: 2; transition: opacity 0.25s ease; }
    .avatar-modal-stage.show-raw canvas { opacity: 0; }
    .sb-name { font-family: var(--cond); font-size: 23px; font-weight: 500; line-height: 1.02; letter-spacing: 0.01em; }

    .sb-cta {
      display: flex; align-items: center; justify-content: space-between;
      background: var(--white); color: var(--bg);
      padding: 9px 12px; border-radius: 3px;
      font-family: var(--cond); font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      transition: transform 0.12s ease, opacity 0.15s ease;
    }
    .sb-cta:hover { opacity: 0.92; }
    .sb-cta:active { transform: scale(0.98); }

    .sb-group-tag {
      display: inline-block;
      background: var(--white); color: var(--bg);
      font-family: var(--cond); font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
      padding: 1px 6px; border-radius: 2px; text-transform: uppercase; margin-bottom: 8px;
    }
    .sb-nav { list-style: none; display: flex; flex-direction: column; }
    .sb-nav li { border-bottom: 1px dotted var(--line); }
    .sb-nav a {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 6px; font-family: var(--cond); font-size: 14px; font-weight: 500;
      letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted);
      will-change: transform, color;
    }
    .sb-nav a:hover, .sb-nav a.active { color: var(--white); }
    .sb-ico { font-family: var(--mono); font-size: 11px; color: var(--text-dim); width: 16px; text-align: center; }

    .sb-foot {
      padding-top: 14px; border-top: 1px dotted var(--line);
      font-family: var(--cond); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted);
    }
    .sb-foot a:hover { color: var(--white); }

    /* CENTER CONTENT */
    .main {
      min-width: 0;
      padding: 24px clamp(16px, 4.5vw, 68px) 120px;
      max-width: 980px;
      width: 100%;
    }
    .breadcrumb {
      font-family: var(--cond); font-size: 13px; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--text-dim); margin-bottom: 52px;
    }

    /* Hero */
    .hero { padding-bottom: 64px; border-bottom: 1px dotted var(--line); }
    .hero h1 {
      font-family: var(--cond); font-size: clamp(3.4rem, 7vw, 5.4rem);
      font-weight: 400; line-height: 0.96; letter-spacing: -0.01em; color: var(--white);
      max-width: 640px; margin-bottom: 24px;
    }
    .hero-desc {
      font-size: 15px; font-weight: 300; color: var(--text-muted);
      max-width: 490px; line-height: 1.65; margin-bottom: 28px;
    }
    .hero-actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; margin-bottom: 44px; }
    .btn-cobalt {
      background: var(--cobalt); color: var(--white);
      padding: 10px 20px; border-radius: 3px;
      font-family: var(--cond); font-size: 14px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
      transition: background 0.15s ease, transform 0.12s ease;
    }
    .btn-cobalt:hover { background: var(--cobalt-hover); }
    .btn-cobalt:active { transform: scale(0.98); }
    .link-under {
      font-family: var(--cond); font-size: 14px; font-weight: 500; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--text-muted);
      border-bottom: 1px solid var(--line-strong); padding-bottom: 2px;
    }
    .link-under:hover { color: var(--white); border-color: var(--white); }

    /* Halftone / Dithered Technical Banner */
    .dither-strip {
      position: relative;
      border: 1px solid var(--line);
      background:
        radial-gradient(rgba(160, 172, 255, 0.24) 1px, transparent 1px),
        linear-gradient(90deg, rgba(31, 43, 255, 0.22), rgba(4, 4, 36, 0.92) 55%, rgba(31, 43, 255, 0.18));
      background-size: 6px 6px, 100% 100%;
      padding: 20px 22px;
      border-radius: 3px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .d-metric { opacity: 0; }
    .d-metric span { display: block; font-size: 10.5px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; }
    .d-metric strong { font-family: var(--cond); font-size: 30px; font-weight: 500; color: var(--white); line-height: 1.1; }

    /* Sections */
    .section { padding: 64px 0; border-bottom: 1px dotted var(--line); }
    .sec-title {
      font-family: var(--cond); font-size: clamp(2.1rem, 4vw, 3.1rem);
      font-weight: 400; color: var(--white); line-height: 1.05; margin-bottom: 28px;
    }
    .sec-head-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 26px; }
    .sec-head-row .sec-title { margin-bottom: 0; }

    /* Numbered Highlights (#1 #2 #3 #4 — Staggered Editorial + Dithered ASCII Art) */
    .num-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 36px 32px; align-items: start; }
    .num-item { display: flex; flex-direction: column; gap: 16px; opacity: 0; }
    .num-item.stagger-rev { margin-top: 26px; }
    .num-meta { padding-top: 12px; border-top: 1px dotted var(--line); }
    .num-idx { font-family: var(--mono); font-size: 11px; color: var(--text-dim); margin-bottom: 6px; }
    .num-item h3 { font-family: var(--cond); font-size: 24px; font-weight: 500; color: var(--white); margin-bottom: 6px; }
    .num-item p { font-size: 13.5px; font-weight: 300; color: var(--text-muted); line-height: 1.65; }
    .ascii-art-box {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 10;
      border: 1px solid var(--line);
      border-radius: 3px;
      overflow: hidden;
      background: #020218;
    }
    .ascii-art-box canvas { width: 100%; height: 100%; display: block; image-rendering: pixelated; }
    .ascii-art-tag {
      position: absolute; bottom: 8px; left: 8px;
      background: rgba(3, 3, 28, 0.88); border: 1px solid var(--line-strong);
      padding: 2px 7px; font-family: var(--mono); font-size: 9.5px; color: #b7c0ff; letter-spacing: 0.08em;
    }

    /* Project Dithered ASCII Preview Frame */
    .svc-preview {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 1px solid var(--line);
      border-radius: 2px;
      overflow: hidden;
      background: #020218;
      margin-bottom: 4px;
    }
    .svc-preview canvas {
      position: relative; z-index: 2; width: 100%; height: 100%; display: block;
      image-rendering: pixelated; transition: opacity 0.28s ease;
    }
    .svc-preview img.raw-peek {
      position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .svc-card:hover .svc-preview.has-raw canvas { opacity: 0.08; }
    .svc-preview-badge {
      position: absolute; top: 7px; right: 7px; z-index: 3;
      background: rgba(3, 3, 28, 0.85); border: 1px solid var(--line-strong);
      padding: 1px 6px; font-family: var(--mono); font-size: 9px; color: #b7c0ff;
      letter-spacing: 0.06em; pointer-events: none;
    }

    /* Hero Full-Bleed Video Background */
    .hero {
      position: relative;
      padding: 28px 24px 56px;
      margin: -16px -24px 0;
      border-bottom: 1px dotted var(--line);
      border-radius: 4px;
      overflow: hidden;
    }
    .hero-video-wrap {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .hero-video-bg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.44;
      filter: contrast(1.08) saturate(1.1);
      display: block;
    }
    .hero-video-scrim {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 75% 25%, rgba(31, 43, 255, 0.22), transparent 55%),
        linear-gradient(180deg, rgba(4, 4, 36, 0.42) 0%, rgba(4, 4, 36, 0.78) 58%, #040424 100%);
    }
    .hero > *:not(.hero-video-wrap) { position: relative; z-index: 1; }

    /* 3D GitHub Statistics Panel */
    .gh-panel {
      background: #020218; border: 1px solid var(--line-strong); border-radius: 3px;
      overflow: hidden; margin-top: 28px; opacity: 0;
    }
    .gh-top {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 14px; border-bottom: 1px dotted var(--line); font-size: 11px; color: var(--text-dim); flex-wrap: wrap; gap: 10px;
    }
    .gh-tabs { display: flex; gap: 6px; }
    .gh-tab {
      background: transparent; border: 1px solid var(--line); color: var(--text-muted);
      font-family: var(--cond); font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase;
      padding: 4px 11px; border-radius: 2px; cursor: pointer;
    }
    .gh-tab.active { background: var(--cobalt); border-color: var(--cobalt); color: var(--white); font-weight: 600; }
    .gh-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .gh-meta b { color: var(--white); font-weight: 600; }
    .gh-live-dot { width: 6px; height: 6px; border-radius: 50%; background: #38e59d; display: inline-block; margin-right: 5px; box-shadow: 0 0 8px rgba(56, 229, 157, 0.7); }

    .gh-stage { position: relative; width: 100%; height: 290px; background: radial-gradient(circle at 50% 60%, rgba(31, 43, 255, 0.14), transparent 68%), #020218; overflow: hidden; }
    .gh-stage canvas { width: 100%; height: 100%; display: block; cursor: grab; }
    .gh-stage canvas:active { cursor: grabbing; }
    .gh-tip {
      position: absolute; pointer-events: none; opacity: 0;
      background: rgba(3, 3, 28, 0.94); border: 1px solid var(--line-strong); border-radius: 2px;
      padding: 5px 9px; font-family: var(--mono); font-size: 11px; color: var(--white);
      white-space: nowrap; z-index: 5; transition: opacity 0.12s ease;
    }
    .gh-hint {
      position: absolute; right: 12px; bottom: 10px; font-family: var(--mono); font-size: 10px;
      color: var(--text-dim); letter-spacing: 0.05em; pointer-events: none;
    }

    .gh-view-list {
      display: none; padding: 14px 16px; height: 290px; overflow-y: auto; overscroll-behavior: contain;
      scrollbar-width: thin; scrollbar-color: var(--cobalt) #020218;
    }
    .gh-view-list::-webkit-scrollbar { width: 5px; }
    .gh-view-list::-webkit-scrollbar-track { background: #020218; }
    .gh-view-list::-webkit-scrollbar-thumb { background: var(--cobalt); border-radius: 2px; }

    .gh-repo-grid { display: flex; flex-direction: column; gap: 10px; }
    .gh-repo-card {
      background: #040424; border: 1px dashed var(--line-strong); border-radius: 2px;
      padding: 11px 14px; display: flex; flex-direction: column; gap: 5px;
      font-family: var(--mono); transition: border-color 0.16s ease, background 0.16s ease;
    }
    .gh-repo-card:hover { border-style: solid; border-color: var(--white); background: rgba(31, 43, 255, 0.12); }
    .gh-repo-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 11.5px; }
    .gh-repo-name { color: var(--white); font-weight: 600; }
    .gh-repo-name em { color: #8c9bff; font-style: normal; margin-right: 6px; }
    .gh-repo-lang { font-size: 10px; color: #8c9bff; border: 1px solid var(--line); padding: 1px 6px; border-radius: 2px; }
    .gh-repo-desc { font-size: 11.5px; color: var(--text-muted); line-height: 1.5; padding-left: 14px; border-left: 1px dotted var(--line-strong); }
    .gh-repo-foot { display: flex; justify-content: space-between; font-size: 10px; color: var(--text-dim); padding-top: 4px; }

    .gh-ascii-langs {
      font-family: var(--mono); font-size: 11.5px; line-height: 1.85; color: var(--text-muted);
      white-space: pre; overflow-x: auto;
    }
    .gh-ascii-langs .l-name { color: var(--white); font-weight: 600; }
    .gh-ascii-langs .l-bar-on { color: #6c7dff; text-shadow: 0 0 8px rgba(31, 43, 255, 0.8); }
    .gh-ascii-langs .l-bar-hi { color: var(--white); }
    .gh-ascii-langs .l-bar-off { color: rgba(140, 155, 255, 0.22); }
    .gh-ascii-langs .l-pct { color: #38e59d; }

    /* Filters */
    .filters { display: flex; gap: 6px; flex-wrap: wrap; }
    .filter-btn {
      background: transparent; border: 1px solid var(--line); color: var(--text-muted);
      font-family: var(--cond); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase;
      padding: 5px 12px; border-radius: 2px; cursor: pointer;
    }
    .filter-btn.active { background: var(--white); color: var(--bg); border-color: var(--white); font-weight: 600; }

    /* Systems Grid */
    .svc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .svc-card {
      background: var(--bg-card); border: 1px solid var(--line); border-radius: 3px; padding: 20px;
      display: flex; flex-direction: column; gap: 10px; opacity: 0;
    }
    .svc-card:hover { border-color: var(--line-strong); background: var(--bg-card-hover); }
    .svc-top { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--text-dim); }
    .svc-proto { background: rgba(31, 43, 255, 0.25); border: 1px solid rgba(110, 125, 255, 0.45); color: #b7c0ff; padding: 1px 7px; border-radius: 2px; font-weight: 600; }
    .svc-name { font-family: var(--cond); font-size: 24px; font-weight: 500; color: var(--white); line-height: 1.1; }
    .svc-desc { font-size: 13.5px; font-weight: 300; color: var(--text-muted); flex: 1; }
    .svc-stack { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 10px; border-top: 1px dotted var(--line); }
    .chip { font-family: var(--mono); font-size: 10.5px; color: var(--text-muted); border: 1px solid var(--line); padding: 2px 7px; border-radius: 2px; }

    /* Experience List — Far-Left Pixel-Centered Dotted ASCII Timeline Slider */
    .exp-list { display: flex; flex-direction: column; position: relative; padding-left: 36px; }
    .exp-track-rail {
      position: absolute;
      left: 10px;
      top: 28px;
      bottom: 28px;
      width: 6px;
      background-image: radial-gradient(circle, rgba(140, 155, 255, 0.28) 1.4px, transparent 1.7px);
      background-size: 6px 10px;
      background-repeat: repeat-y;
      background-position: center top;
      pointer-events: none;
      z-index: 1;
    }
    .exp-track-fill {
      position: absolute;
      left: 0;
      top: 0;
      width: 6px;
      height: 0%;
      background-image: radial-gradient(circle, #ffffff 1.6px, rgba(31, 43, 255, 0.85) 2.2px, transparent 2.6px);
      background-size: 6px 10px;
      background-repeat: repeat-y;
      background-position: center top;
      filter: drop-shadow(0 0 6px rgba(140, 155, 255, 0.85));
      will-change: height;
    }
    .exp-track-pulse {
      position: absolute;
      left: 3px;
      top: 0;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 0 10px #ffffff, 0 0 18px #1f2bff;
      transform: translate(-50%, -50%);
      will-change: top;
    }
    .exp-row {
      position: relative;
      z-index: 2;
      display: grid; grid-template-columns: 155px 1fr; gap: 20px;
      padding: 22px 14px; border-bottom: 1px dotted var(--line); opacity: 0;
      border-radius: 3px; transition: background 0.18s ease;
    }
    .exp-row::before {
      content: '';
      position: absolute;
      left: -23px;
      top: 26px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid var(--text-dim);
      transform: translateX(-50%);
      box-shadow: 0 0 0 3px var(--bg);
      transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }
    .exp-row.is-lit::before, .exp-row.is-now::before {
      border-color: var(--white);
      background: var(--cobalt);
      box-shadow: 0 0 0 3px var(--bg), 0 0 12px rgba(31, 43, 255, 0.9);
    }
    .exp-row:hover { background: rgba(31, 43, 255, 0.08); }
    .exp-row:last-child { border-bottom: none; }
    .exp-date { font-size: 11.5px; color: var(--text-dim); }
    .exp-now { display: inline-block; margin-top: 6px; background: var(--cobalt); color: var(--white); font-family: var(--cond); font-size: 11px; letter-spacing: 0.08em; padding: 1px 7px; border-radius: 2px; }
    .exp-ascii-meter { margin-top: 8px; font-family: var(--mono); font-size: 10px; color: #6d7cff; letter-spacing: 0.04em; opacity: 0.85; }
    .exp-role { font-family: var(--cond); font-size: 24px; font-weight: 500; color: var(--white); line-height: 1.1; margin-bottom: 3px; }
    .exp-org { font-size: 13px; color: var(--text-muted); margin-bottom: 6px; }
    .exp-desc { font-size: 13.5px; font-weight: 300; color: var(--text-dim); }

    /* Research Papers + Book ASCII Art */
    .paper-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .paper-card {
      background: var(--bg-card); border: 1px solid var(--line); border-radius: 3px; padding: 22px;
      display: flex; flex-direction: column; gap: 10px; opacity: 0;
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .paper-card:hover { border-color: var(--cobalt); background: var(--bg-card-hover); }
    .paper-ascii {
      background: #020218;
      border: 1px solid var(--line);
      border-radius: 2px;
      padding: 12px 8px;
      font-family: var(--mono);
      font-size: clamp(6.2px, 0.72vw, 9.2px);
      line-height: 1.18;
      color: #8c9bff;
      overflow-x: auto;
      white-space: pre;
      text-align: center;
      text-shadow: 0 0 8px rgba(31, 43, 255, 0.55);
      transition: color 0.2s ease, border-color 0.2s ease;
    }
    .paper-card:hover .paper-ascii { color: var(--white); border-color: var(--line-strong); }
    .paper-card h3 { font-family: var(--cond); font-size: 23px; font-weight: 500; color: var(--white); line-height: 1.15; }
    .paper-card p { font-size: 13.5px; font-weight: 300; color: var(--text-muted); flex: 1; }
    .paper-cta { font-family: var(--cond); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #8c9bff; }

    /* RIGHT RAIL — Precision Telemetry & Skill Radar Dock */
    .right-rail {
      position: sticky;
      top: 0;
      height: 100vh;
      border-left: 1px solid var(--line);
      background:
        radial-gradient(circle at 50% 18%, rgba(56, 189, 248, 0.08), transparent 52%),
        radial-gradient(circle at 50% 85%, rgba(31, 43, 255, 0.12), transparent 55%),
        var(--bg-sidebar);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 14px 8px 16px;
      gap: 14px;
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: none;
    }
    .right-rail::-webkit-scrollbar { display: none; }
    .shell.rail-open .right-rail {
      align-items: stretch;
      padding: 14px 14px 16px;
      gap: 12px;
    }

    /* Header bar inside Right Rail */
    .rail-panel-head {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-shrink: 0;
    }
    .shell.rail-open .rail-panel-head {
      justify-content: space-between;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--line);
    }
    .rail-head-meta {
      display: none;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }
    .shell.rail-open .rail-head-meta { display: flex; }
    .rail-head-title {
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--white);
      white-space: nowrap;
    }
    .rail-live-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 7px;
      border-radius: 999px;
      background: rgba(56, 229, 157, 0.1);
      border: 1px solid rgba(56, 229, 157, 0.25);
      font-family: var(--mono);
      font-size: 9.5px;
      font-weight: 600;
      color: #38e59d;
      letter-spacing: 0.04em;
    }
    .rail-pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #38e59d;
      box-shadow: 0 0 8px rgba(56, 229, 157, 0.85);
      animation: railPulse 2.2s ease-in-out infinite;
      flex-shrink: 0;
    }
    @keyframes railPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.45; transform: scale(0.82); }
    }

    .rail-toggle {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--line-strong);
      color: var(--text-muted);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      cursor: pointer;
      display: grid;
      place-items: center;
      font-family: var(--mono);
      font-size: 13px;
      flex-shrink: 0;
      transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.15s ease;
    }
    .rail-toggle:hover {
      color: var(--white);
      border-color: rgba(56, 189, 248, 0.55);
      background: rgba(56, 189, 248, 0.1);
    }
    .rail-toggle:active { transform: scale(0.95); }

    /* Collapsed Dock Stack */
    .rail-collapsed-dock {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      width: 100%;
      flex: 1;
      padding-top: 6px;
    }
    .shell.rail-open .rail-collapsed-dock { display: none; }
    .rail-status-mini {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      padding: 6px 0 8px;
      border-bottom: 1px solid var(--line);
      width: 32px;
    }
    .rail-status-mini span {
      font-family: var(--mono);
      font-size: 8px;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: #38e59d;
    }
    .rail-pill-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      width: 100%;
    }
    .rail-pill-btn {
      width: 34px;
      height: 26px;
      border-radius: 6px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.025);
      color: var(--text-muted);
      font-family: var(--mono);
      font-size: 9.5px;
      font-weight: 600;
      letter-spacing: 0.04em;
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease, transform 0.15s ease;
    }
    .rail-pill-btn:hover {
      border-color: rgba(56, 189, 248, 0.55);
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.1);
      transform: translateX(-1px);
    }
    .rail-scroll-track {
      width: 2px;
      flex: 1;
      min-height: 48px;
      max-height: 150px;
      margin: 6px 0;
      background: rgba(160, 168, 255, 0.14);
      border-radius: 999px;
      position: relative;
      overflow: visible;
    }
    .rail-scroll-fill {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 0%;
      background: linear-gradient(180deg, #38bdf8, #6366f1);
      border-radius: 999px;
    }
    .rail-scroll-knob {
      position: absolute;
      left: 50%;
      top: 0%;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #38bdf8;
      box-shadow: 0 0 8px rgba(56, 189, 248, 0.85);
      transform: translate(-50%, -50%);
    }

    /* Expanded Panel */
    .rail-expanded-box {
      display: none;
      width: 100%;
      flex: 1;
      flex-direction: column;
      gap: 12px;
    }
    .shell.rail-open .rail-expanded-box { display: flex; }

    .rail-radar-card {
      background: linear-gradient(180deg, rgba(11, 13, 46, 0.92) 0%, rgba(6, 7, 29, 0.96) 100%);
      border: 1px solid rgba(160, 168, 255, 0.18);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 14px 32px rgba(0, 0, 0, 0.36);
    }
    .rail-radar-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 12px 6px;
      gap: 6px;
    }
    .rail-radar-label {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .rail-tab-group {
      display: inline-flex;
      gap: 4px;
    }
    .rail-tab-btn {
      padding: 3px 7px;
      border-radius: 5px;
      border: 1px solid rgba(160, 168, 255, 0.16);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text-dim);
      font-family: var(--mono);
      font-size: 9.5px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.16s ease;
    }
    .rail-tab-btn:hover { color: var(--white); border-color: rgba(160, 168, 255, 0.35); }
    .rail-tab-btn.active {
      background: rgba(56, 189, 248, 0.16);
      border-color: rgba(56, 189, 248, 0.55);
      color: #38bdf8;
    }

    .rail-radar-canvas-wrap {
      width: 100%;
      height: 210px;
      background: transparent;
      position: relative;
    }
    .rail-radar-canvas-wrap canvas { width: 100%; height: 100%; display: block; }

    .rail-skill-table {
      padding: 10px 12px 12px;
      border-top: 1px solid rgba(160, 168, 255, 0.12);
      font-family: var(--mono);
      font-size: 10.5px;
      line-height: 1.5;
      color: var(--text-muted);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .rail-skill-head {
      color: var(--white);
      font-weight: 600;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
    }
    .rail-skill-legend {
      display: flex;
      gap: 12px;
      font-size: 10px;
      margin-bottom: 2px;
    }
    .rail-skill-legend span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .lg-dot { width: 6px; height: 6px; border-radius: 2px; display: inline-block; }
    .lg-a { color: #38bdf8; } .lg-a .lg-dot { background: #38bdf8; }
    .lg-b { color: #a5b4fc; } .lg-b .lg-dot { background: #818cf8; }

    .rail-skill-row {
      display: grid;
