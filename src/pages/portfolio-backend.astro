  <script is:inline>
    // 1. LENIS Smooth Linear Scroll synced with GSAP
    gsap.registerPlugin(ScrollTrigger);
    const lenis = new Lenis({
      duration: 1.15,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true
    });
    // Lenis-Driven Continuous Kinetic Ruler Sidebar (Zero DOM reads in loop!)
    const sbRulerWrap = document.getElementById('sbRulerWrap');
    const sbRulerCanvas = document.getElementById('sbRulerCanvas');
    const sbRulerCtx = sbRulerCanvas ? sbRulerCanvas.getContext('2d') : null;
    const sbNeedle = document.getElementById('sbNeedle');
    const sbRulerPct = document.getElementById('sbRulerPct');
    const breadcrumbEl = document.querySelector('.breadcrumb');

    const navItems = [
      { id: 'overview', label: '// OVERVIEW' },
      { id: 'architecture', label: '// ARCHITECTURE' },
      { id: 'systems', label: '// SYSTEMS (11)' },
      { id: 'experience', label: '// EXPERIENCE' },
      { id: 'research', label: '// RESEARCH PAPERS' }
    ].map(item => ({
      ...item,
      link: document.querySelector(`.sb-nav a[href="#${item.id}"]`),
      section: document.getElementById(item.id),
      linkCenterY: 0,
      secTop: 0
    })).filter(i => i.link && i.section);

    let rulerH = 260;
    let maxScroll = 1;
    let currentNeedleY = 0;
    let targetNeedleY = 0;
    let currentTickOffset = 0;

    function measureNavPositions() {
      if (!sbRulerWrap) return;
      const wrapRect = sbRulerWrap.getBoundingClientRect();
      rulerH = Math.max(120, Math.round(wrapRect.height));
      if (sbRulerCanvas) {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        sbRulerCanvas.width = Math.floor(16 * dpr);
        sbRulerCanvas.height = Math.floor(rulerH * dpr);
        sbRulerCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      navItems.forEach(item => {
        const r = item.link.getBoundingClientRect();
        item.linkCenterY = (r.top - wrapRect.top) + r.height * 0.5;
        item.secTop = item.section.getBoundingClientRect().top + window.scrollY;
      });
      // Ensure last section maps cleanly to max scroll
      maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      if (navItems.length > 0) {
        navItems[0].secTop = 0;
        navItems[navItems.length - 1].secTop = Math.min(navItems[navItems.length - 1].secTop, maxScroll);
      }
    }

    function isLightMode() { return document.documentElement.classList.contains('light'); }

    function drawRulerTicks(needleY, tickShift) {
      if (!sbRulerCtx) return;
      sbRulerCtx.clearRect(0, 0, 16, rulerH);
      const light = isLightMode();
      const step = 6;
      const offset = ((tickShift % 30) + 30) % 30;
      for (let y = -30 + offset; y <= rulerH + 30; y += step) {
        if (y < 0 || y > rulerH) continue;
        const dist = Math.abs(y - needleY);
        const prox = Math.max(0, 1 - dist / 42);
        const isMajor = Math.round(y - offset) % 30 === 0;
        const len = (isMajor ? 10 : 5) + prox * 5;
        const alpha = (isMajor ? 0.38 : 0.18) + prox * 0.58;
        if (light) {
          sbRulerCtx.fillStyle = prox > 0.45
            ? `rgba(31, 43, 255, ${alpha.toFixed(2)})`
            : `rgba(15, 23, 84, ${alpha.toFixed(2)})`;
        } else {
          sbRulerCtx.fillStyle = prox > 0.45
            ? `rgba(255, 255, 255, ${alpha.toFixed(2)})`
            : `rgba(160, 168, 255, ${alpha.toFixed(2)})`;
        }
        sbRulerCtx.fillRect(0, Math.round(y), len, 1);
      }
    }

    function computeNeedleTarget(scrollY) {
      if (!navItems.length) return 0;
      const probe = Math.max(0, Math.min(maxScroll, scrollY + window.innerHeight * 0.22));
      if (scrollY <= 4) return navItems[0].linkCenterY;
      if (scrollY >= maxScroll - 8) return navItems[navItems.length - 1].linkCenterY;

      for (let i = 0; i < navItems.length - 1; i++) {
        const a = navItems[i];
        const b = navItems[i + 1];
        if (probe >= a.secTop && probe <= b.secTop) {
          const span = Math.max(1, b.secTop - a.secTop);
          const t = Math.max(0, Math.min(1, (probe - a.secTop) / span));
          return a.linkCenterY + (b.linkCenterY - a.linkCenterY) * t;
        }
      }
      return probe < navItems[0].secTop ? navItems[0].linkCenterY : navItems[navItems.length - 1].linkCenterY;
    }

    function updateRulerVisuals(scrollY, immediate = false) {
      if (!navItems.length) return;
      targetNeedleY = computeNeedleTarget(scrollY);
      if (immediate) currentNeedleY = targetNeedleY;
      else currentNeedleY += (targetNeedleY - currentNeedleY) * 0.18;

      currentTickOffset = -scrollY * 0.08;
      if (sbNeedle) {
        sbNeedle.style.transform = `translate3d(0, ${currentNeedleY.toFixed(2)}px, 0)`;
      }
      drawRulerTicks(currentNeedleY, currentTickOffset);

      // Find nearest nav item to needle & apply magnetic proximity shift
      let closest = navItems[0];
      let minDist = Infinity;
      navItems.forEach(item => {
        const d = Math.abs(item.linkCenterY - currentNeedleY);
        if (d < minDist) { minDist = d; closest = item; }
        const prox = Math.max(0, 1 - d / 36);
        item.link.style.transform = `translate3d(${(prox * 7).toFixed(2)}px, 0, 0)`;
        item.link.classList.toggle('active', d < 18);
      });

      if (breadcrumbEl && closest) breadcrumbEl.textContent = closest.label;
      if (sbRulerPct) {
        const pct = Math.round(Math.max(0, Math.min(1, scrollY / maxScroll)) * 100);
        sbRulerPct.textContent = String(pct).padStart(2, '0') + '%';
      }
    }

    let latestScrollY = 0;
    lenis.on('scroll', ({ scroll }) => {
      latestScrollY = scroll;
      ScrollTrigger.update();
    });
    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
      updateRulerVisuals(latestScrollY, false);
    });
    gsap.ticker.lagSmoothing(0);

    window.addEventListener('resize', () => {
      measureNavPositions();
      updateRulerVisuals(latestScrollY, true);
    });

    requestAnimationFrame(() => {
      measureNavPositions();
      updateRulerVisuals(window.scrollY, true);
    });

    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', (e) => {
        const href = a.getAttribute('href');
        const el = document.querySelector(href);
        if (el) {
          e.preventDefault();
          lenis.scrollTo(el, { offset: -24, duration: 1.15 });
        }
      });
    });

    // 2. GSAP Per-Kata Bi-Directional Reveal (Scroll Bawah & Scroll Atas!)
    function splitToWords(el) {
      const walk = (node) => {
        if (node.nodeType === 3) {
          const parts = node.nodeValue.split(/(\s+)/);
          const frag = document.createDocumentFragment();
          parts.forEach(part => {
            if (!part) return;
            if (/^\s+$/.test(part)) frag.appendChild(document.createTextNode(part));
            else {
              const mask = document.createElement('span'); mask.className = 'word-mask';
              const inner = document.createElement('span'); inner.className = 'word-inner'; inner.textContent = part;
              mask.appendChild(inner); frag.appendChild(mask);
            }
          });
          node.parentNode.replaceChild(frag, node);
        } else if (node.nodeType === 1) Array.from(node.childNodes).forEach(walk);
      };
      walk(el);
      return el.querySelectorAll('.word-inner');
    }

    function bindBiDirWords(el, delay = 0) {
      const words = splitToWords(el);
      gsap.set(words, { yPercent: 110, opacity: 0 });
      ScrollTrigger.create({
        trigger: el,
        start: 'top 86%',
        end: 'bottom 14%',
        onEnter: () => gsap.fromTo(words,
          { yPercent: 110, opacity: 0 },
          { yPercent: 0, opacity: 1, duration: 0.62, stagger: { each: 0.032, from: 'start' }, delay, ease: 'power3.out', overwrite: true }
        ),
        onLeaveBack: () => gsap.to(words,
          { yPercent: 110, opacity: 0, duration: 0.42, stagger: { each: 0.022, from: 'end' }, ease: 'power2.in', overwrite: true }
        ),
        onEnterBack: () => gsap.fromTo(words,
          { yPercent: -110, opacity: 0 },
          { yPercent: 0, opacity: 1, duration: 0.62, stagger: { each: 0.032, from: 'end' }, ease: 'power3.out', overwrite: true }
        ),
        onLeave: () => gsap.to(words,
          { yPercent: -110, opacity: 0, duration: 0.38, stagger: { each: 0.02, from: 'start' }, ease: 'power2.in', overwrite: true }
        )
      });
    }

    document.querySelectorAll('.gsap-words').forEach((el, i) => bindBiDirWords(el, i * 0.12));
    document.querySelectorAll('.gsap-scroll-words').forEach(el => bindBiDirWords(el, 0));

    // Data Rendering
    const services = [
      { id: '01', name: 'MariMatcha Shop', cat: 'API & Web', proto: 'REST', img: '/assets/p-marimatcha.png', scene: 'bars', desc: 'E-commerce Matcha premium dengan katalog, transaksi, dan backoffice operasional Laravel & MySQL.', stack: ['Laravel', 'CodeIgniter 3', 'PHP', 'MySQL'] },
      { id: '02', name: 'JurnalKu AI', cat: 'AI / RAG', proto: 'API', img: '/assets/p-jurnalku.png', scene: 'nodes', desc: 'Platform riset akademik AI untuk indexing dan analisis jurnal ilmiah berbasis Python & Supabase.', stack: ['Python', 'Next.js', 'Supabase'] },
      { id: '03', name: 'PrepMaster AI', cat: 'AI / RAG', proto: 'STREAM', img: null, scene: 'wave', desc: 'Simulasi wawancara adaptif berbasis STAR rubric dari CV PDF dengan audio real-time & debrief PDF.', stack: ['Next.js 14', 'Web Speech', 'PDF'] },
      { id: '04', name: 'NotesBrain RAG', cat: 'AI / RAG', proto: 'VECTOR', img: null, scene: 'nodes', desc: 'Workspace studi multi-dokumen dengan grounded RAG, hybrid search pgvector, dan SuperMemo-2.', stack: ['PostgreSQL', 'pgvector', 'TypeScript'] },
