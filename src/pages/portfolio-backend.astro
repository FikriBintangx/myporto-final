    // 5. BAYER 4x4 DITHER + ASCII MATRIX ENGINE (Architecture Art + App Previews + Hero Ambient)
    const BAYER4 = [
      [0, 8, 2, 10],
      [12, 4, 14, 6],
      [3, 11, 1, 9],
      [15, 7, 13, 5]
    ];
    const ASCII_RAMP = ' .:-=+*#%@';

    function renderDitheredSource(srcCanvas, targetCanvas, w, h, asciiOverlay = true) {
      targetCanvas.width = w;
      targetCanvas.height = h;
      const light = isLightMode();
      const sctx = srcCanvas.getContext('2d', { willReadFrequently: true });
      const tctx = targetCanvas.getContext('2d');
      const imgData = sctx.getImageData(0, 0, w, h);
      const data = imgData.data;
      const out = tctx.createImageData(w, h);
      const o = out.data;

      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const idx = (y * w + x) * 4;
          const lum = (0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2]) / 255;
          const thresh = (BAYER4[y & 3][x & 3] + 0.5) / 16;
          if (light) {
            if (lum > thresh * 0.94) {
              const hi = lum > 0.72;
              o[idx] = hi ? 7 : 31;
              o[idx + 1] = hi ? 9 : 43;
              o[idx + 2] = hi ? 43 : 255;
              o[idx + 3] = 255;
            } else {
              o[idx] = 244;
              o[idx + 1] = 247;
              o[idx + 2] = 253;
              o[idx + 3] = 255;
            }
          } else {
            if (lum > thresh * 0.92) {
              const hi = lum > 0.72;
              o[idx] = hi ? 242 : 76;
              o[idx + 1] = hi ? 244 : 94;
              o[idx + 2] = 255;
              o[idx + 3] = 255;
            } else {
              o[idx] = 4;
              o[idx + 1] = 4;
              o[idx + 2] = 34;
              o[idx + 3] = 255;
            }
          }
        }
      }
      tctx.putImageData(out, 0, 0);

      if (asciiOverlay) {
        tctx.font = '7px "IBM Plex Mono", monospace';
        tctx.fillStyle = light ? 'rgba(7, 9, 43, 0.36)' : 'rgba(210, 218, 255, 0.34)';
        for (let y = 6; y < h; y += 9) {
          for (let x = 3; x < w; x += 6) {
            const idx = (y * w + x) * 4;
            const lum = (0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2]) / 255;
            if (lum > 0.22 && lum < 0.82) {
              const ch = ASCII_RAMP[Math.min(ASCII_RAMP.length - 1, Math.floor(lum * ASCII_RAMP.length))];
              tctx.fillText(ch, x, y);
            }
          }
        }
      }
    }

    function drawProceduralScene(ctx2, kind, w, h, t) {
      ctx2.fillStyle = '#05051f';
      ctx2.fillRect(0, 0, w, h);
      const cx = w * 0.5, cy = h * 0.5;

      if (kind === 'orbital') {
        const g = ctx2.createRadialGradient(cx, cy, 4, cx, cy, h * 0.52);
        g.addColorStop(0, '#ffffff'); g.addColorStop(0.45, '#5b6eff'); g.addColorStop(1, '#040424');
        ctx2.fillStyle = g;
        ctx2.beginPath(); ctx2.arc(cx, cy, h * 0.36, 0, Math.PI * 2); ctx2.fill();
        ctx2.strokeStyle = '#ffffff'; ctx2.lineWidth = 2;
        for (let i = 0; i < 3; i++) {
          ctx2.save(); ctx2.translate(cx, cy); ctx2.rotate(t * (0.4 + i * 0.2) + i);
          ctx2.beginPath(); ctx2.ellipse(0, 0, h * (0.45 + i * 0.12), h * 0.16, 0, 0, Math.PI * 2); ctx2.stroke();
          ctx2.restore();
        }
      } else if (kind === 'nodes') {
        const pts = [];
        for (let i = 0; i < 9; i++) {
          const a = (i / 9) * Math.PI * 2 + t * 0.25;
          const r = h * (0.22 + (i % 3) * 0.11);
          pts.push({ x: cx + Math.cos(a) * r * 1.45, y: cy + Math.sin(a) * r });
        }
        ctx2.strokeStyle = '#8b9aff'; ctx2.lineWidth = 1.5;
        for (let i = 0; i < pts.length; i++) {
          for (let j = i + 1; j < pts.length; j++) {
            if ((i + j) % 3 === 0) { ctx2.beginPath(); ctx2.moveTo(pts[i].x, pts[i].y); ctx2.lineTo(pts[j].x, pts[j].y); ctx2.stroke(); }
          }
        }
        pts.forEach((p, idx) => {
          const gr = ctx2.createRadialGradient(p.x, p.y, 1, p.x, p.y, 14);
          gr.addColorStop(0, '#ffffff'); gr.addColorStop(1, 'rgba(31,43,255,0)');
          ctx2.fillStyle = gr; ctx2.beginPath(); ctx2.arc(p.x, p.y, 14, 0, Math.PI * 2); ctx2.fill();
        });
      } else if (kind === 'shield') {
        for (let i = 0; i < 14; i++) {
          const y = (i / 14) * h;
          ctx2.strokeStyle = i % 2 === 0 ? '#ffffff' : '#6b7bff';
          ctx2.lineWidth = 2;
          ctx2.beginPath();
          for (let x = 0; x <= w; x += 6) {
            const wy = y + Math.sin(x * 0.045 + t * 2 + i * 0.6) * 10;
            if (x === 0) ctx2.moveTo(x, wy); else ctx2.lineTo(x, wy);
          }
          ctx2.stroke();
        }
      } else if (kind === 'cluster' || kind === 'bars') {
        const cols = 14;
        const bw = (w - 28) / cols;
        for (let i = 0; i < cols; i++) {
          const bh = (0.22 + 0.68 * Math.abs(Math.sin(t * 1.1 + i * 0.55))) * (h - 24);
          const gr = ctx2.createLinearGradient(0, h - bh, 0, h);
          gr.addColorStop(0, '#ffffff'); gr.addColorStop(0.5, '#6b7bff'); gr.addColorStop(1, '#121663');
          ctx2.fillStyle = gr;
          ctx2.fillRect(14 + i * bw, h - 10 - bh, bw - 4, bh);
        }
      } else if (kind === 'wave') {
        for (let l = 0; l < 5; l++) {
          ctx2.strokeStyle = l === 2 ? '#ffffff' : '#7b8bff';
          ctx2.lineWidth = l === 2 ? 3 : 1.5;
          ctx2.beginPath();
          for (let x = 0; x <= w; x += 4) {
            const amp = Math.sin((x / w) * Math.PI) * (h * 0.34);
            const y = cy + Math.sin(x * 0.06 + t * 2.4 + l * 0.8) * amp;
            if (x === 0) ctx2.moveTo(x, y); else ctx2.lineTo(x, y);
          }
          ctx2.stroke();
        }
      } else if (kind === 'radar') {
        ctx2.strokeStyle = '#6f7fff'; ctx2.lineWidth = 1.5;
        for (let r = 16; r < h * 0.48; r += 18) { ctx2.beginPath(); ctx2.arc(cx, cy, r, 0, Math.PI * 2); ctx2.stroke(); }
        const ang = t * 1.4;
        const g = ctx2.createRadialGradient(cx + Math.cos(ang) * 28, cy + Math.sin(ang) * 28, 2, cx, cy, h * 0.48);
        g.addColorStop(0, '#ffffff'); g.addColorStop(1, 'rgba(31,43,255,0)');
        ctx2.fillStyle = g;
        ctx2.beginPath(); ctx2.moveTo(cx, cy); ctx2.arc(cx, cy, h * 0.46, ang - 0.65, ang); ctx2.closePath(); ctx2.fill();
      } else {
        // grid
        const step = 18;
        for (let y = 10; y < h; y += step) {
          for (let x = 10; x < w; x += step) {
            const v = (Math.sin(x * 0.05 + t) + Math.cos(y * 0.06 - t)) * 0.5 + 0.5;
            ctx2.fillStyle = v > 0.62 ? '#ffffff' : (v > 0.32 ? '#596aff' : '#10144a');
            ctx2.fillRect(x, y, step - 4, step - 4);
          }
        }
      }
    }

    // Animated Architecture ASCII/Dither Canvases + High-DPI Colored ASCII Radar Skill Profile
    const offscreen = document.createElement('canvas');
    const offCtx = offscreen.getContext('2d', { willReadFrequently: true });
    const archCanvases = Array.from(document.querySelectorAll('canvas[data-ascii-scene]'));
    const railRadarCanvas = document.getElementById('railRadarCanvas');
    const railRadarCtx = railRadarCanvas ? railRadarCanvas.getContext('2d') : null;
    const railSkillTable = document.getElementById('railSkillTable');
    const radarProfileTag = document.getElementById('radarProfileTag');
    let asciiT = 0;

    // Crisp Vector Dual-Layer Skill Radar (Sky Blue + Indigo) with Interactive Profile Tabs
    const radarLabels = ['API', 'Backend', 'DevOps', 'Data', 'Security', 'Testing'];
    const radarSets = [
      { labelA: 'Core API', labelB: 'Systems Ops', a: [92, 95, 78, 90, 84, 82], b: [76, 74, 92, 85, 91, 88] },
      { labelA: 'Data / RAG', labelB: 'Infra Net', a: [84, 88, 72, 96, 80, 79], b: [72, 82, 94, 76, 88, 84] },
      { labelA: 'Security', labelB: 'Fullstack', a: [82, 86, 85, 78, 95, 90], b: [90, 92, 74, 86, 72, 80] }
    ];
    let lastRadarTableIdx = -1;
    let lockedRadarTab = null;

    const railTabBtns = Array.from(document.querySelectorAll('[data-radar-tab]'));
    railTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.radarTab);
        lockedRadarTab = (lockedRadarTab === idx) ? null : idx;
        railTabBtns.forEach(b => b.classList.toggle('active', Number(b.dataset.radarTab) === (lockedRadarTab ?? idx)));
        lastRadarTableIdx = -1;
        renderRadarMorph(asciiT);
      });
    });

    document.querySelectorAll('[data-open-rail]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.openRail);
        lockedRadarTab = idx;
        railTabBtns.forEach(b => b.classList.toggle('active', Number(b.dataset.radarTab) === idx));
        const shell = document.getElementById('portalShell');
        const toggleBtn = document.getElementById('btnRailToggle');
        if (shell && !shell.classList.contains('rail-open')) {
          shell.classList.add('rail-open');
          if (toggleBtn) toggleBtn.textContent = '→';
          if (typeof syncAfterLayout === 'function') syncAfterLayout();
        }
        lastRadarTableIdx = -1;
        setTimeout(() => renderRadarMorph(asciiT), 60);
      });
    });

    function updateSkillTable(setIdx, valsA, valsB) {
      if (!railSkillTable) return;
      const s = radarSets[setIdx];
      const avgA = Math.round(valsA.reduce((p, c) => p + c, 0) / valsA.length);
      const avgB = Math.round(valsB.reduce((p, c) => p + c, 0) / valsB.length);
      const avgD = avgA - avgB;
      const avgDs = (avgD >= 0 ? '+' : '') + avgD;
      const rows = radarLabels.map((lbl, i) => {
        const va = Math.round(valsA[i]), vb = Math.round(valsB[i]);
        const d = va - vb;
        const ds = (d >= 0 ? '+' : '') + d;
        return `<div class="rail-skill-row">
          <span class="rail-skill-name">${lbl}</span>
          <div class="rail-skill-bars">
            <div class="rail-skill-bar-track"><div class="rail-skill-bar-a" style="width:${va}%"></div></div>
            <div class="rail-skill-bar-track"><div class="rail-skill-bar-b" style="width:${vb}%"></div></div>
          </div>
          <span class="v-a">${va}</span><span class="v-b">${vb}</span>
          <span class="v-delta ${d >= 0 ? 'v-pos' : 'v-neg'}">${ds}</span>
        </div>`;
      }).join('');
      railSkillTable.innerHTML = `
        <div class="rail-skill-head">
          <span>Benchmark Matrix</span>
          <span style="color:var(--text-dim); font-size:9.5px;">${setIdx + 1} / 3</span>
        </div>
        <div class="rail-skill-legend">
          <span class="lg-a"><i class="lg-dot"></i>${s.labelA}</span>
          <span class="lg-b"><i class="lg-dot"></i>${s.labelB}</span>
        </div>
        ${rows}
        <div class="rail-skill-avg">
          <span style="color:var(--text-dim); text-transform:uppercase; font-size:9px; letter-spacing:0.08em;">AVG</span>
          <span></span>
          <span class="v-a">${avgA}</span>
          <span class="v-b">${avgB}</span>
          <span class="v-delta ${avgD >= 0 ? 'v-pos' : 'v-neg'}">${avgDs}</span>
        </div>
      `;
    }

    function renderRadarMorph(t) {
      if (!railRadarCanvas || !railRadarCtx) return;
      const wrap = railRadarCanvas.parentElement;
      const rect = wrap.getBoundingClientRect();
      if (rect.width < 40 || rect.height < 40) return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.floor(rect.width), h = Math.floor(rect.height);
      if (railRadarCanvas.width !== Math.floor(w * dpr) || railRadarCanvas.height !== Math.floor(h * dpr)) {
        railRadarCanvas.width = Math.floor(w * dpr);
        railRadarCanvas.height = Math.floor(h * dpr);
      }
      railRadarCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const light = isLightMode();
      railRadarCtx.clearRect(0, 0, w, h);

      let i0, valsA, valsB, ease = 0;
      if (lockedRadarTab !== null) {
        i0 = lockedRadarTab;
        valsA = radarSets[i0].a;
        valsB = radarSets[i0].b;
      } else {
        const phase = (t * 0.20) % radarSets.length;
        i0 = Math.floor(phase);
        const i1 = (i0 + 1) % radarSets.length;
        const frac = phase - i0;
        ease = frac < 0.7 ? 0 : Math.pow((frac - 0.7) / 0.3, 2) * (3 - 2 * ((frac - 0.7) / 0.3));
        valsA = radarSets[i0].a.map((v, k) => v + (radarSets[i1].a[k] - v) * ease);
        valsB = radarSets[i0].b.map((v, k) => v + (radarSets[i1].b[k] - v) * ease);
        railTabBtns.forEach(b => b.classList.toggle('active', Number(b.dataset.radarTab) === i0));
      }

      if (i0 !== lastRadarTableIdx || ease > 0) {
        lastRadarTableIdx = i0;
        updateSkillTable(i0, valsA, valsB);
      }
      if (radarProfileTag) {
        radarProfileTag.textContent = (lockedRadarTab !== null ? 'Pinned · ' : 'Auto · ') + `${i0 + 1}/3`;
      }

      const cx = w * 0.5, cy = h * 0.52;
      const maxR = Math.min(w, h) * 0.36;

      // Clean concentric hexagonal web rings + radial spokes
      railRadarCtx.lineWidth = 1;
      for (let ring = 1; ring <= 4; ring++) {
        const rr = (maxR * ring) / 4;
        railRadarCtx.beginPath();
        for (let a = 0; a < 6; a++) {
          const ang = (a * Math.PI) / 3 - Math.PI / 2;
          const px = cx + Math.cos(ang) * rr;
          const py = cy + Math.sin(ang) * rr;
          if (a === 0) railRadarCtx.moveTo(px, py);
          else railRadarCtx.lineTo(px, py);
        }
        railRadarCtx.closePath();
        railRadarCtx.strokeStyle = light
          ? `rgba(15, 23, 84, ${ring === 4 ? 0.16 : 0.08})`
          : `rgba(160, 168, 255, ${ring === 4 ? 0.22 : 0.1})`;
        railRadarCtx.stroke();
      }
      for (let a = 0; a < 6; a++) {
        const ang = (a * Math.PI) / 3 - Math.PI / 2;
        railRadarCtx.beginPath();
        railRadarCtx.moveTo(cx, cy);
        railRadarCtx.lineTo(cx + Math.cos(ang) * maxR, cy + Math.sin(ang) * maxR);
        railRadarCtx.strokeStyle = light ? 'rgba(15, 23, 84, 0.08)' : 'rgba(160, 168, 255, 0.1)';
        railRadarCtx.stroke();
      }

      const toVerts = (arr) => arr.map((v, a) => {
        const ang = (a * Math.PI) / 3 - Math.PI / 2;
        const r = (v / 100) * maxR;
        return { x: cx + Math.cos(ang) * r, y: cy + Math.sin(ang) * r };
      });
      const vA = toVerts(valsA);
      const vB = toVerts(valsB);

      const drawPoly = (verts, stroke, fillTop, fillBot, dashed) => {
        const grad = railRadarCtx.createLinearGradient(cx, cy - maxR, cx, cy + maxR);
        grad.addColorStop(0, fillTop);
        grad.addColorStop(1, fillBot);

        railRadarCtx.save();
        railRadarCtx.beginPath();
        verts.forEach((p, i) => (i === 0 ? railRadarCtx.moveTo(p.x, p.y) : railRadarCtx.lineTo(p.x, p.y)));
        railRadarCtx.closePath();
        railRadarCtx.fillStyle = grad;
        railRadarCtx.fill();

        if (dashed) railRadarCtx.setLineDash([3, 3]);
        railRadarCtx.strokeStyle = stroke;
        railRadarCtx.lineWidth = dashed ? 1.4 : 1.8;
        railRadarCtx.stroke();
        railRadarCtx.restore();

        verts.forEach(p => {
          railRadarCtx.beginPath();
          railRadarCtx.arc(p.x, p.y, dashed ? 2.4 : 3.0, 0, Math.PI * 2);
          railRadarCtx.fillStyle = stroke;
          railRadarCtx.fill();
          railRadarCtx.lineWidth = 1.2;
          railRadarCtx.strokeStyle = light ? '#ffffff' : '#080924';
          railRadarCtx.stroke();
        });
      };

      drawPoly(vB, '#818cf8', 'rgba(129, 140, 248, 0.22)', 'rgba(99, 102, 241, 0.05)', true);
      drawPoly(vA, '#38bdf8', 'rgba(56, 189, 248, 0.28)', 'rgba(2, 132, 199, 0.06)', false);

      // Crisp axis labels
      railRadarCtx.font = '600 9.5px "IBM Plex Mono", monospace';
      railRadarCtx.fillStyle = light ? '#3f456e' : '#cbd5e1';
      railRadarCtx.textAlign = 'center';
      railRadarCtx.textBaseline = 'middle';
      radarLabels.forEach((lbl, a) => {
        const ang = (a * Math.PI) / 3 - Math.PI / 2;
        const lx = cx + Math.cos(ang) * (maxR + 18);
        const ly = cy + Math.sin(ang) * (maxR + 15);
        railRadarCtx.fillText(lbl, lx, ly);
      });
    }

    function tickAsciiScenes() {
      asciiT += 0.04;
      const w = 184, h = 115;
      offscreen.width = w; offscreen.height = h;

      renderRadarMorph(asciiT);
      archCanvases.forEach((c, idx) => {
        drawProceduralScene(offCtx, c.dataset.asciiScene, w, h, asciiT * 0.7 + idx * 1.1);
        renderDitheredSource(offscreen, c, w, h, true);
      });
      setTimeout(() => requestAnimationFrame(tickAsciiScenes), 65);
    }
    tickAsciiScenes();

    // Project Card Dithered ASCII Previews (Real Screenshots + Procedural Fallback)
    function initProjectAsciiCanvases() {
      const w = 192, h = 108;
      document.querySelectorAll('canvas[data-proj-canvas]').forEach((c, idx) => {
        const imgUrl = c.dataset.img;
        const scene = c.dataset.scene || 'nodes';
        const tmp = document.createElement('canvas');
        tmp.width = w; tmp.height = h;
        const tctx = tmp.getContext('2d', { willReadFrequently: true });

        if (imgUrl) {
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => {
            const scale = Math.max(w / img.width, h / img.height);
            const dw = img.width * scale, dh = img.height * scale;
            tctx.drawImage(img, (w - dw) * 0.5, (h - dh) * 0.5, dw, dh);
            renderDitheredSource(tmp, c, w, h, true);
          };
          img.onerror = () => {
            drawProceduralScene(tctx, scene, w, h, idx * 0.9);
            renderDitheredSource(tmp, c, w, h, true);
          };
          img.src = imgUrl;
        } else {
          drawProceduralScene(tctx, scene, w, h, idx * 1.2 + 0.5);
          renderDitheredSource(tmp, c, w, h, true);
        }
      });
    }
    // Render Sidebar Avatar Portrait + Enlarged Lightbox Modal
    function initAvatarAscii() {
      const av = document.getElementById('sbAvatarAscii');
      const avModalCanvas = document.getElementById('avatarModalCanvas');
      if (!av) return;
      const img = new Image();
      img.onload = () => {
        const renderTo = (target, size) => {
          if (!target) return;
          const tmp = document.createElement('canvas');
          tmp.width = size; tmp.height = size;
          const tctx = tmp.getContext('2d', { willReadFrequently: true });
          const scale = Math.max(size / img.width, size / img.height);
          const dw = img.width * scale, dh = img.height * scale;
          tctx.drawImage(img, (size - dw) * 0.5, 0, dw, dh);
          renderDitheredSource(tmp, target, size, size, true);
        };
        renderTo(av, 72);
        renderTo(avModalCanvas, 220);
      };
      img.src = av.dataset.img;

      const modal = document.getElementById('avatarModal');
      const card = document.getElementById('avatarModalCard');
      const stage = document.getElementById('avatarModalStage');
      const btnOpen = document.getElementById('sbAvatarBtn');
      const btnClose = document.getElementById('btnAvClose');
      const btnAscii = document.getElementById('btnAvAscii');
      const btnRaw = document.getElementById('btnAvRaw');

      const openModal = () => {
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
        anime({ targets: card, opacity: [0, 1], scale: [0.88, 1], duration: 320, easing: 'easeOutExpo' });
      };
      const closeModal = () => {
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
      };

      if (btnOpen) {
        btnOpen.addEventListener('click', openModal);
        btnOpen.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(); } });
      }
      if (btnClose) btnClose.addEventListener('click', closeModal);
      if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal && modal.classList.contains('open')) closeModal(); });

      if (btnAscii && btnRaw && stage) {
        btnAscii.addEventListener('click', () => {
          stage.classList.remove('show-raw');
          btnAscii.classList.add('active'); btnRaw.classList.remove('active');
        });
        btnRaw.addEventListener('click', () => {
          stage.classList.add('show-raw');
          btnRaw.classList.add('active'); btnAscii.classList.remove('active');
        });
      }
    }

