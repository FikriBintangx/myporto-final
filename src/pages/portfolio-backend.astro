    /* Sticky Hero + Foreground Curtain Overlap Layer (Nous-style Layer Scrub) */
    @media (min-width: 961px) {
      .hero-sticky-stage {
        position: sticky;
        top: 20px;
        z-index: 1;
        will-change: transform, opacity, filter;
        transform-origin: center top;
      }
    }
    .curtain-layer {
      position: relative;
      z-index: 10;
      background: var(--bg);
      margin: 24px calc(clamp(16px, 4.5vw, 68px) * -1) 0;
      padding: 18px clamp(16px, 4.5vw, 68px) 0;
      border-top: 1px solid rgba(160, 174, 255, 0.24);
      border-radius: 26px 26px 0 0;
      box-shadow: 0 -28px 72px rgba(2, 2, 20, 0.88), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }
    html.light .curtain-layer {
      border-top-color: rgba(15, 23, 84, 0.16);
      box-shadow: 0 -22px 54px rgba(7, 9, 43, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }
    .curtain-seam {
      width: 44px;
      height: 4px;
      border-radius: 999px;
      background: rgba(160, 174, 255, 0.26);
      margin: 0 auto 10px;
    }
    html.light .curtain-seam { background: rgba(15, 23, 84, 0.18); }
    @media (max-width: 960px) {
      .curtain-layer {
        margin: 16px -16px 0;
        padding: 14px 16px 0;
        border-radius: 20px 20px 0 0;
      }
    }

    /* Monumental Cinematic Footer & Scroll-Scrubbed Perspective Stage */
    .scroll-perspective-wrap {
      perspective: 1200px;
    }
    .scroll-stage-card {
      transform-origin: center top;
      will-change: transform, opacity;
    }
    .monolith-footer {
      position: relative;
      margin-top: 24px;
      border-top: 1px solid var(--line);
      overflow: hidden;
      background: #0a0c1e;
    }
    html.light .monolith-footer {
      background: #0e122d;
      color: #f4f5ff;
    }
    .monolith-upper {
      position: relative;
      padding: clamp(56px, 9vw, 112px) clamp(20px, 4vw, 48px) clamp(44px, 7vw, 84px);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: clamp(220px, 28vw, 340px);
    }
    .monolith-watermark {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      user-select: none;
      overflow: hidden;
    }
    .monolith-watermark span {
      font-family: var(--cond);
      font-weight: 700;
      font-size: clamp(110px, 21vw, 290px);
      line-height: 0.85;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      color: rgba(160, 174, 255, 0.06);
      white-space: nowrap;
      will-change: transform;
    }
    .monolith-meta-row {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 20px;
    }
    .monolith-meta-left,
    .monolith-meta-right {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(214, 220, 255, 0.72);
    }
    .monolith-meta-right { text-align: right; align-items: flex-end; }
    .monolith-meta-sub { color: rgba(148, 163, 214, 0.56); font-size: 10px; }
    .monolith-badges {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    .monolith-badge {
      width: 44px;
      height: 54px;
      border-radius: 6px;
      border: 1px solid rgba(160, 174, 255, 0.24);
      background: rgba(12, 16, 44, 0.65);
      backdrop-filter: blur(8px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      color: #e2e8ff;
      font-family: var(--mono);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.06em;
      transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
    }
    .monolith-badge:hover {
      transform: translateY(-3px);
      border-color: #38bdf8;
      background: rgba(31, 43, 255, 0.22);
      color: #ffffff;
    }
    .monolith-horizon {
      position: relative;
      height: clamp(160px, 24vw, 280px);
      overflow: hidden;
      background: linear-gradient(180deg, #0d1657 0%, #16249a 55%, #1f2bff 100%);
      border-top: 1px solid rgba(129, 140, 248, 0.28);
    }
    .monolith-horizon-img {
      position: absolute;
      inset: -18% 0;
      width: 100%;
      height: 136%;
      object-fit: cover;
      object-position: center 22%;
      filter: grayscale(100%) contrast(1.25) brightness(0.75) blur(3.5px);
      mix-blend-mode: luminosity;
      opacity: 0.52;
      will-change: transform;
    }
    .monolith-horizon-wash {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 45%, rgba(56, 189, 248, 0.18), transparent 60%),
        linear-gradient(180deg, rgba(10, 12, 30, 0.62) 0%, rgba(20, 31, 148, 0.45) 45%, rgba(31, 43, 255, 0.72) 100%);
      pointer-events: none;
    }
    .monolith-horizon-caption {
      position: absolute;
      left: clamp(20px, 4vw, 48px);
      right: clamp(20px, 4vw, 48px);
      bottom: 18px;
      z-index: 2;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(226, 232, 255, 0.78);
    }
    .monolith-top-btn {
      padding: 5px 11px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.26);
      background: rgba(4, 4, 36, 0.38);
      backdrop-filter: blur(8px);
      color: #ffffff;
      cursor: pointer;
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      transition: background 0.18s ease, border-color 0.18s ease;
    }
    .monolith-top-btn:hover { background: rgba(255, 255, 255, 0.14); border-color: #ffffff; }
    @media (max-width: 760px) {
      .monolith-meta-row { grid-template-columns: 1fr; text-align: center; gap: 18px; }
      .monolith-meta-left, .monolith-meta-right { align-items: center; text-align: center; }
    }

    /* Local Preview Switcher */
    .preview-bar {
      position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); z-index: 100;
      display: flex; align-items: center; gap: 6px; padding: 5px;
      background: rgba(3, 3, 28, 0.94); backdrop-filter: blur(12px);
      border: 1px solid var(--line-strong); border-radius: 4px;
      font-family: var(--mono); font-size: 11px;
    }
    .preview-bar a { padding: 6px 12px; border-radius: 2px; color: var(--text-muted); white-space: nowrap; }
    .preview-bar a:hover { color: var(--white); }
    .preview-bar a.active { background: var(--cobalt); color: var(--white); font-weight: 600; }

    /* Mobile Top Bar & Drawer */
    .mob-topbar {
      display: none;
      position: sticky; top: 0; z-index: 60;
      background: var(--bg-sidebar); border-bottom: 1px solid var(--line);
      padding: 10px 16px; align-items: center; justify-content: space-between; gap: 10px;
    }
    .mob-brand { font-family: var(--cond); font-size: 19px; font-weight: 600; color: var(--white); letter-spacing: 0.02em; }
    .mob-controls { display: flex; align-items: center; gap: 6px; }
    .mob-nav-strip {
      display: none; overflow-x: auto; gap: 8px; padding: 8px 16px;
      background: var(--bg); border-bottom: 1px dotted var(--line);
      scrollbar-width: none;
    }
    .mob-nav-strip::-webkit-scrollbar { display: none; }
    .mob-nav-strip a {
      flex-shrink: 0; font-family: var(--cond); font-size: 12.5px; letter-spacing: 0.07em;
      text-transform: uppercase; color: var(--text-muted); padding: 4px 10px;
      border: 1px solid var(--line); border-radius: 2px;
    }
    .mob-nav-strip a:hover { color: var(--white); border-color: var(--cobalt); }

    @media (max-width: 1120px) {
      .paper-grid { grid-template-columns: 1fr; }
      .paper-ascii { font-size: clamp(7.5px, 1.4vw, 10px); }
    }

    @media (max-width: 960px) {
      .shell, .shell.sb-min, .shell.rail-open, .shell.sb-min.rail-open { grid-template-columns: 1fr; }
      .sidebar, .right-rail { display: none; }
      .mob-topbar { display: flex; }
      .mob-nav-strip { display: flex; }
      .mob-lang-wrap { display: none !important; }
      .main { padding: 18px 16px 88px; max-width: 100%; }
      .hero { margin: -8px -16px 0; padding: 22px 16px 40px; }
      .breadcrumb { margin-bottom: 24px; }
      .dither-strip { grid-template-columns: repeat(2, 1fr); padding: 16px; }
      .num-list, .svc-grid, .paper-grid { grid-template-columns: 1fr; gap: 18px; }
      .num-item.stagger-rev { margin-top: 0; }
      .exp-list { padding-left: 26px; }
      .exp-track-rail { left: 6px; }
      .exp-row { grid-template-columns: 1fr; gap: 8px; padding: 16px 10px; }
      .exp-row::before { left: -17px; top: 20px; }
      .gh-stage { height: 235px; }
      .gh-view-list { height: 260px; }
      .gh-ascii-langs { font-size: clamp(8px, 2.15vw, 11px); }
      .paper-ascii { font-size: clamp(6.5px, 2.1vw, 9.5px); }
    }

    @media (max-width: 480px) {
      .hero h1 { font-size: 2.6rem; }
      .dither-strip { grid-template-columns: 1fr 1fr; gap: 12px; }
      .d-metric strong { font-size: 24px; }
      .gh-top { padding: 10px 12px; }
      .gh-meta { font-size: 10px; gap: 8px; }
    }
  </style>
