        bc: { overview: '// OVERVIEW', architecture: '// ARCHITECTURE', systems: '// SYSTEMS (11)', experience: '// EXPERIENCE', research: '// RESEARCH PAPERS' },
        svcDesc: {
          '01': 'Premium Matcha e-commerce platform with catalog, checkout, and Laravel & MySQL operational admin backoffice.',
          '02': 'AI academic research platform for indexing, searching, and analyzing scientific journals built with Python & Supabase.',
          '03': 'Adaptive mock interview simulator using STAR rubrics from uploaded CV PDFs with real-time audio & PDF debrief export.',
          '04': 'Multi-document study workspace with grounded RAG, pgvector hybrid search, PDF highlighting, and SuperMemo-2 flashcards.',
          '05': 'Offline-first zero-waste kitchen PWA with fridge vision scanning, local IndexedDB storage, and step-by-step timers.',
          '06': 'Natural-language property search wired to bi-directional interactive maps via tool calling and .ics visit scheduling.',
          '07': 'Daily expense tracker with Indonesian slang parser, receipt extraction, and offline-first micro SVG analytics.',
          '08': 'Community dues & treasury mobile app built with Flutter & Supabase for real-time billing and financial transparency.',
          '09': 'Desktop employee attendance & payroll system for accurate timekeeping, payslip generation, and automated reporting.',
          '10': 'Digital marketing content management platform for campaign scheduling, reach analytics, and JasperReports output.',
          '11': 'Integrated used-car dealership platform for vehicle inventory catalogs, sales administration, and dealer CRM.'
        },
        exp: [
          { date: '2026 – Present', role: 'Backend Developer & Fullstack Engineer', desc: 'Building and optimizing corporate REST APIs, admin backoffice systems, mobile API integrations (Node.js/Express & SQL), and MikroTik network infrastructure.' },
          { date: '2024 – Present', role: 'B.Sc. Informatics Engineering (Software Eng.)', desc: 'Focused on software engineering, information systems architecture, cybersecurity, and applied computing research.' },
          { date: '2025 – Sep 2025', role: 'Crew Member', desc: 'High-tempo operational SOP execution with strict quality control and service consistency.' },
          { date: '2024 – 2025', role: 'Production Machine Operator', desc: 'Operating high-precision industrial machinery for automotive components under strict manufacturing QC standards.' },
          { date: '2023 – 2024', role: 'Operations & Logistics Staff', desc: 'Accurate inbound/outbound shipment reconciliation and cross-branch warehouse data reporting.' }
        ]
      }
    };

    let currentLang = localStorage.getItem('p2_lang') || 'id';
    let currentFilter = 'ALL';

    const SCRAMBLE_GLYPHS = '!<>-_\\/[]{}—=+*^?#01';
    function scrambleDecode(el, finalText) {
      if (!el) return;
      clearInterval(el.__scrambleTimer);
      let frame = 0;
      const total = Math.max(12, Math.min(22, finalText.length));
      el.__scrambleTimer = setInterval(() => {
        frame++;
        const progress = frame / total;
        const locked = Math.floor(progress * finalText.length);
        let out = '';
        for (let i = 0; i < finalText.length; i++) {
          const ch = finalText[i];
          if (ch === ' ') out += ' ';
          else if (i < locked) out += ch;
          else out += SCRAMBLE_GLYPHS[(i * 7 + frame * 3) % SCRAMBLE_GLYPHS.length];
        }
        el.textContent = out;
        if (frame >= total) {
          clearInterval(el.__scrambleTimer);
          el.textContent = finalText;
        }
      }, 24);
    }

    const expMeters = ['[██████░░] LIVE', '[█████░░░] 3.34', '[████░░░░] OPS ', '[████░░░░] MFG ', '[███░░░░░] LOG '];

    let expTrackST = null;

    function renderExpList() {
      const t = i18n[currentLang];
      const expEl = document.getElementById('expList');
      expEl.querySelectorAll('.exp-row').forEach(r => {
        itemTriggers = itemTriggers.filter(st => { if (st.trigger === r) { st.kill(); return false; } return true; });
      });
      if (expTrackST) { expTrackST.kill(); expTrackST = null; }

      expEl.innerHTML = `
        <div class="exp-track-rail" aria-hidden="true">
          <div class="exp-track-fill" id="expTrackFill"></div>
          <div class="exp-track-pulse" id="expTrackPulse"></div>
        </div>
      ` + experiences.map((e, i) => `
        <article class="exp-row ${e.now ? 'is-now' : ''}" data-anime-item>
          <div class="mono">
            <div class="exp-date">${t.exp[i].date}</div>
            ${e.now ? `<span class="exp-now">${t.current_role}</span>` : ''}
            <div class="exp-ascii-meter" data-meter-idx="${i}">${expMeters[i] || '[███░░░░░]'}</div>
          </div>
          <div>
            <h3 class="exp-role" data-final-role="${t.exp[i].role.replace(/"/g, '&quot;')}">${t.exp[i].role}</h3>
            <div class="exp-org">${e.org}</div>
            <p class="exp-desc">${t.exp[i].desc}</p>
          </div>
        </article>
      `).join('');

      const rows = Array.from(expEl.querySelectorAll('.exp-row'));
      rows.forEach(row => {
        bindAnimeItem(row);
        const roleEl = row.querySelector('.exp-role');
        const finalRole = roleEl ? roleEl.dataset.finalRole : '';
        row.addEventListener('mouseenter', () => scrambleDecode(roleEl, finalRole));
        ScrollTrigger.create({
          trigger: row,
          start: 'top 86%',
          end: 'bottom 14%',
          onEnter: () => scrambleDecode(roleEl, finalRole),
          onEnterBack: () => scrambleDecode(roleEl, finalRole)
        });
      });

      // Continuous Connected Beam scrubbed bi-directionally by Lenis + ScrollTrigger
      const fillEl = document.getElementById('expTrackFill');
      const pulseEl = document.getElementById('expTrackPulse');
      expTrackST = ScrollTrigger.create({
        trigger: expEl,
        start: 'top 76%',
        end: 'bottom 45%',
        scrub: 0.35,
        onUpdate: (self) => {
          const pct = Math.max(0, Math.min(1, self.progress));
          if (fillEl) fillEl.style.height = (pct * 100).toFixed(2) + '%';
          if (pulseEl) pulseEl.style.top = (pct * 100).toFixed(2) + '%';
          rows.forEach((r, idx) => {
            const threshold = rows.length > 1 ? idx / (rows.length - 1) : 0;
            r.classList.toggle('is-lit', pct >= threshold - 0.04);
          });
        }
      });
    }

    // Left Sidebar Minimize (Ruler + Menu Only) & Right Rail Expand Toggle
    const portalShell = document.getElementById('portalShell');
    const btnSbMin = document.getElementById('btnSbMin');
    const btnSbExpand = document.getElementById('btnSbExpand');
    const btnRailToggle = document.getElementById('btnRailToggle');

    function syncAfterLayout() {
      setTimeout(() => {
        measureNavPositions();
        updateRulerVisuals(latestScrollY, true);
        resizeCanvas();
        ScrollTrigger.refresh();
      }, 300);
    }

    if (btnSbMin) btnSbMin.addEventListener('click', () => {
      portalShell.classList.add('sb-min');
      syncAfterLayout();
    });
    if (btnSbExpand) btnSbExpand.addEventListener('click', () => {
      portalShell.classList.remove('sb-min');
      syncAfterLayout();
    });
    if (btnRailToggle) btnRailToggle.addEventListener('click', () => {
      const open = portalShell.classList.toggle('rail-open');
      btnRailToggle.textContent = open ? '→' : '←';
      syncAfterLayout();
    });

    function applyLanguage(lang) {
      currentLang = lang === 'en' ? 'en' : 'id';
      localStorage.setItem('p2_lang', currentLang);
      document.documentElement.lang = currentLang;
      const t = i18n[currentLang];

      document.querySelectorAll('[data-set-lang]').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.setLang === currentLang);
      });

      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.dataset.i18n;
        if (t[key]) el.textContent = t[key];
      });

      document.querySelectorAll('[data-i18n-words]').forEach(el => {
        const key = el.dataset.i18nWords;
        if (!t[key]) return;
        ScrollTrigger.getAll().forEach(st => { if (st.trigger === el) st.kill(); });
        el.textContent = t[key];
        bindBiDirWords(el, 0);
      });

      navItems.forEach(item => {
        if (t.bc[item.id]) item.label = t.bc[item.id];
      });

      services.forEach(s => { if (t.svcDesc[s.id]) s.desc = t.svcDesc[s.id]; });
      renderSvcs(currentFilter);
      renderExpList();
      ScrollTrigger.refresh();
      requestAnimationFrame(() => {
        measureNavPositions();
        updateRulerVisuals(latestScrollY, true);
      });
    }

    document.querySelectorAll('[data-set-lang]').forEach(btn => {
      btn.addEventListener('click', () => applyLanguage(btn.dataset.setLang));
    });

    // Light / Dark Mode Switcher (Persisted in localStorage + Instant Canvas Redraw)
    const ICON_SUN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>';
    const ICON_MOON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';

    function applyTheme(mode) {
      const isLight = mode === 'light';
      document.documentElement.classList.toggle('light', isLight);
      document.documentElement.classList.toggle('dark', !isLight);
      localStorage.setItem('p2_theme', isLight ? 'light' : 'dark');
      document.querySelectorAll('[data-toggle-theme]').forEach(btn => {
        btn.innerHTML = isLight ? ICON_MOON : ICON_SUN;
        btn.title = isLight ? 'Switch to Dark Mode' : 'Switch to Light Mode';
      });
      if (window.__asciiReady) {
        initAvatarAscii();
        initProjectAsciiCanvases();
        updateRulerVisuals(latestScrollY, true);
      }
    }

    document.querySelectorAll('[data-toggle-theme]').forEach(btn => {
      btn.addEventListener('click', () => {
        applyTheme(isLightMode() ? 'dark' : 'light');
      });
    });

    // Server-side Admin Config Injection
    const __srvCfg = window.__SITE_THEME_CFG__ || {};
    if (__srvCfg.enableHeroVideo === false) {
      const vw = document.querySelector('.hero-video-wrap');
      if (vw) vw.style.display = 'none';
    }
    if (__srvCfg.enable3DGithub === false) {
      const gh = document.getElementById('github');
      if (gh) gh.style.display = 'none';
    }
    const initMode = __srvCfg.colorMode === 'system'
      ? (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
      : (__srvCfg.colorMode || localStorage.getItem('p2_theme') || 'dark');
    const initLang = __srvCfg.defaultLang || localStorage.getItem('p2_lang') || 'id';
    applyTheme(initMode);
    applyLanguage(initLang);

    document.querySelectorAll('#svcFilters .filter-btn').forEach(b => b.addEventListener('click', () => {
      document.querySelectorAll('#svcFilters .filter-btn').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      currentFilter = b.dataset.cat;
      renderSvcs(currentFilter);
    }));

    // Scroll-Scrubbed Perspective Stage & Monumental Footer Parallax (Bi-Directional GSAP Scrub)
    const btnMonolithTop = document.getElementById('btnMonolithTop');
    if (btnMonolithTop) {
      btnMonolithTop.addEventListener('click', () => {
        if (window.lenis) window.lenis.scrollTo(0, { duration: 1.1 });
        else window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        // Sticky Hero Depth Recede as Foreground Curtain Layer overlaps it
        const heroStage = document.getElementById('heroStage');
        const curtainLayer = document.getElementById('curtainLayer');
        if (heroStage && curtainLayer && window.innerWidth > 960) {
          gsap.fromTo(heroStage,
            { scale: 1, y: 0, opacity: 1, filter: 'blur(0px)' },
            {
              scale: 0.93, y: -28, opacity: 0.22, filter: 'blur(2.5px)', ease: 'none',
              scrollTrigger: {
                trigger: curtainLayer,
                start: 'top 95%',
                end: 'top 14%',
                scrub: 0.6
              }
            }
          );
        }

        // 3D Perspective Stage Scrub on major showcase panels
        document.querySelectorAll('.gh-panel, .paper-card').forEach(panel => {
          gsap.fromTo(panel,
            { y: 38, scale: 0.94, rotateX: 8, opacity: 0.72, transformPerspective: 1100, transformOrigin: 'center top' },
            {
              y: 0, scale: 1, rotateX: 0, opacity: 1, ease: 'none',
              scrollTrigger: {
                trigger: panel,
                start: 'top 95%',
                end: 'top 52%',
                scrub: 0.65
              }
            }
          );
        });

        // Monumental Footer Giant Watermark + Deep-Cobalt Horizon Parallax Scrub
        const monolithFooter = document.getElementById('monolithFooter');
        const watermarkText = document.getElementById('monolithWatermarkText');
        const horizonImg = document.getElementById('monolithHorizonImg');
        if (monolithFooter && watermarkText) {
          gsap.fromTo(watermarkText,
            { yPercent: 26, scale: 0.92, opacity: 0.35 },
            {
              yPercent: -6, scale: 1.03, opacity: 1, ease: 'none',
              scrollTrigger: {
                trigger: monolithFooter,
                start: 'top bottom',
                end: 'bottom bottom',
                scrub: 0.7
              }
            }
          );
        }
        if (monolithFooter && horizonImg) {
          gsap.fromTo(horizonImg,
            { yPercent: -14, scale: 1.08 },
            {
              yPercent: 10, scale: 1.0, ease: 'none',
              scrollTrigger: {
                trigger: monolithFooter,
                start: 'top bottom',
                end: 'bottom bottom',
                scrub: 0.7
              }
            }
          );
        }
      }
    }
  </script>
</body>
</html>
