---
import lintreeData from '../data/lintree.json';

const links = lintreeData.filter(item => item.type === 'link');
const cards = lintreeData.filter(item => item.type === 'card');
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FIKRI BINTANG PROFILE | Links</title>
    <meta name="description" content="Official link-in-bio of Fikri Bintang Purnomo — Full Stack & Mobile Developer. Explore projects, contact channels, and portfolio.">
    <meta name="author" content="Fikri Bintang Purnomo">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://fikribintang.web.id/">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="FIKRI BINTANG PROFILE">
    <meta property="og:url" content="https://fikribintang.web.id/">
    <meta property="og:title" content="FIKRI BINTANG PROFILE — Links">
    <meta property="og:description" content="Official link-in-bio of Fikri Bintang Purnomo — Explore projects, contact channels, and portfolio.">
    <meta property="og:image" content="https://fikribintang.web.id/images/profile.jpg">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:url" content="https://fikribintang.web.id/">
    <meta name="twitter:title" content="FIKRI BINTANG PROFILE — Links">
    <meta name="twitter:description" content="Official link-in-bio of Fikri Bintang Purnomo — Explore projects, contact channels, and portfolio.">
    <meta name="twitter:image" content="https://fikribintang.web.id/images/profile.jpg">

    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <link rel="stylesheet" href="/lintree.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <div class="creator-label">CREATOR PROFILE</div>
            
            <div class="profile-avatar-wrapper">
                <img src="/images/profile.jpg" onerror="this.src='/images/logo.jpg'" alt="Fikri Bintang Purnomo" class="profile-avatar" />
            </div>

            <div class="logo-container">
                <div class="logo" title="Click 3x to open Admin Mode">
                    <h1>FIKRI BINTANG <span>PROFILE</span></h1>
                    <div class="logo-sub">WEB & APP DEV<br>EST.2025</div>
                </div>
            </div>
            <p class="tagline">FULL STACK & MOBILE DEVELOPER • EST.2025</p>
        </header>

        <!-- Main Content -->
        <main id="links-container" class="links-list">
            {links.map(item => {
                const isPortfolio = item.url.includes('portfolio') || item.url.includes('porto');
                const isInternal = item.url.startsWith('/') || item.url.startsWith('#');
                return (
                    <a 
                        href={item.url} 
                        class={`link-item ${isPortfolio ? 'featured-portfolio-link' : ''}`}
                        target={isInternal ? undefined : '_blank'}
                        rel={isInternal ? undefined : 'noopener noreferrer'}
                    >
                        <div class="link-icon-wrapper">
                            {item.icon === 'github' ? (
                                <i data-lucide="github"></i>
                            ) : item.icon === 'instagram' ? (
                                <i data-lucide="instagram"></i>
                            ) : item.icon === 'globe' ? (
                                <i data-lucide="globe"></i>
                            ) : item.icon === 'mail' ? (
                                <i data-lucide="mail"></i>
                            ) : item.icon === 'message-circle' || item.icon === 'whatsapp' ? (
                                <i data-lucide="message-circle"></i>
                            ) : item.image_url ? (
                                <img src={item.image_url.startsWith('/') ? item.image_url : `/${item.image_url}`} class="custom-icon" alt="icon" onerror="this.src='https://api.iconify.design/lucide:link.svg'" />
                            ) : (
                                <i data-lucide={item.icon || 'arrow-right'}></i>
                            )}
                        </div>
                        <span>{item.title}</span>
                        {isPortfolio && <span class="featured-badge">EXPLORE ↗</span>}
                    </a>
                );
            })}
        </main>

        <!-- Bottom Grid -->
        <section id="cards-container" class="cards-grid">
            {cards.map(item => {
                const bgUrl = item.image_url ? (item.image_url.startsWith('/') ? item.image_url : `/${item.image_url}`) : '';
                return (
                    <a 
                        href={item.url || '#'} 
                        class={`card-item ${bgUrl ? 'has-bg' : ''}`}
                        target={item.url && item.url.startsWith('http') ? '_blank' : undefined}
                        rel={item.url && item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                        style={bgUrl ? `background-image: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.8)), url('${bgUrl}')` : undefined}
                    >
                        <div class="card-icon">
                            <i data-lucide={item.icon || 'layout'}></i>
                        </div>
                        <div class="card-info">
                            <h3>{item.title}</h3>
                            <p class="card-desc">Featured Project</p>
                        </div>
                    </a>
                );
            })}
        </section>

        <!-- Footer -->
        <footer class="footer">
            <div class="social-links">
                <a href="https://github.com/FikriBintangx" target="_blank" rel="noopener noreferrer">GitHub</a>
                <a href="https://www.instagram.com/biru.css/" target="_blank" rel="noopener noreferrer">Instagram</a>
                <a href="mailto:fikbintang01@gmail.com">Email</a>
                <a href="/portfolio">Portfolio</a>
            </div>
            <p class="copyright">&copy; 2026 FIKRI BINTANG PROFILE</p>
            <p class="branding"><a href="/portfolio" style="color: inherit; text-decoration: none;">Explore Portofolio ↗</a></p>
        </footer>
    </div>

    <!-- Dynamic Island Notification -->
    <div id="dynamic-island-container">
        <div id="dynamic-island">
            <div class="island-content">
                <i id="island-icon" data-lucide="info"></i>
                <span id="island-text">Notification</span>
            </div>
        </div>
    </div>

    <!-- Admin Dashboard (Sliding Panel) -->
    <div id="admin-dashboard" class="admin-overlay">
        <div class="admin-panel">
            <div class="admin-header">
                <h2>Admin Dashboard</h2>
                <button id="close-admin" class="close-btn"><i data-lucide="x"></i></button>
            </div>
            
            <div class="admin-layout">
                <!-- Left: List -->
                <div class="admin-list-pane">
                    <div class="admin-actions">
                        <button id="add-link-btn" class="primary-btn">
                            <i data-lucide="plus"></i> Create New Link
                        </button>
                    </div>
                    <div id="admin-links-list" class="admin-table">
                        <!-- Admin items will be loaded here -->
                    </div>
                </div>

                <!-- Right: Sliding Form Pane -->
                <div id="admin-form-pane" class="admin-form-pane">
                    <div class="form-header">
                        <h3 id="form-title">Add New Link</h3>
                        <button id="close-form" class="icon-btn"><i data-lucide="chevron-right"></i></button>
                    </div>
                    <form id="add-link-form" class="premium-form">
                        <input type="hidden" id="edit-id">
                        <div class="form-group">
                            <label>Title</label>
                            <input type="text" id="title" required placeholder="e.g. My Portfolio">
                        </div>
                        <div class="form-group">
                            <label>URL</label>
                            <input type="text" id="url" required placeholder="example.com">
                        </div>
                        <div class="form-group">
                            <label>Type</label>
                            <select id="type">
                                <option value="link">Standard Link</option>
                                <option value="card">Grid Card</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Icon (Lucide name)</label>
                            <input type="text" id="icon" placeholder="rocket, mail, instagram...">
                            <div class="file-input-wrapper icon-upload" style="margin-top: 0.5rem; height: 40px;">
                                <input type="file" id="icon-file" accept="image/*">
                                <span>Or Upload/Paste Icon Image</span>
                            </div>
                            <img id="icon-preview" src="#" alt="Icon Preview" style="display:none; width: 44px; height: 44px; border-radius: 8px; margin-top: 0.5rem; object-fit: contain; border: 1px solid #eee; background: #f9f9f9;">
                        </div>
                        <div class="form-group">
                            <label>Background Image</label>
                            <div class="file-input-wrapper">
                                <input type="file" id="image-file" accept="image/*">
                                <span>Choose Image</span>
                            </div>
                            <img id="image-preview" src="#" alt="Preview" style="display:none; width: 100%; border-radius: 12px; margin-top: 1rem; border: 1px solid #eee;">
                        </div>
                        <div class="form-footer">
                            <button type="submit" class="save-btn">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script is:inline src="/lintree.js"></script>
    <script is:inline>
        if (window.lucide) {
            window.lucide.createIcons();
        }
    </script>
</body>
</html>
