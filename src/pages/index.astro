---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio | Hermes Style</title>
    <link rel="icon" type="image/jpeg" href="images/logo.jpg">
    <link
        href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,900;1,9..144,900&family=Inter:wght@400;700;900&display=swap"
        rel="stylesheet">
    <!-- Leaflet CSS for Map -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
</head>

<body class="theme-light">
    <!-- Background Image with Opacity -->
    <div class="bg-image"></div>

    <!-- Texture Overlay -->
    <div class="texture-overlay"></div>

    <div class="container">
        <!-- SVG Filter for Glitch Effect -->
        <svg style="position: absolute; width: 0; height: 0;" xmlns="http://www.w3.org/2000/svg" version="1.1">
            <defs>
                <filter id="glitch">
                    <feTurbulence type="fractalNoise" baseFrequency="0.1 0.03" numOctaves="2" result="noise" />
                    <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" xChannelSelector="R"
                        yChannelSelector="G" />
                </filter>
            </defs>
        </svg>
        <!-- Header -->
        <header class="grid-header">
            <div class="header-logo col-border-right">
                <a href="#">
                    <h1 class="logo-font">PORTOFOLIO</h1>
                </a>
            </div>
            <div class="header-nav col-border-right">
                <a href="#home" class="nav-link nav-glitch active" data-translate="nav-home" data-text="HOME">HOME <span
                        class="blink cursor"></span></a>
            </div>
            <div class="header-nav col-border-right">
                <a href="#about" class="nav-link nav-glitch" data-translate="nav-about" data-text="ABOUT">ABOUT <span
                        class="blink cursor"></span></a>
            </div>
            <div class="header-nav col-border-right">
                <a href="#projects" class="nav-link nav-glitch" data-translate="nav-projects" data-text="PROJECTS">PROJECTS <span
                        class="blink cursor"></span></a>
            </div>
            <div class="header-nav col-border-right header-nav-split">
                <a href="#skills" class="nav-link nav-glitch" data-translate="nav-skills" data-text="SKILLS">SKILLS <span
                        class="blink cursor"></span></a>
                <div class="lang-switcher">
                    <button class="lang-btn" data-lang="en">EN</button>
                    <span class="lang-separator">/</span>
                    <button class="lang-btn" data-lang="id">ID</button>
                </div>
                <a href="https://github.com/FikriBintangx" target="_blank" class="nav-link github-icon" title="GitHub">
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path
                            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22">
                        </path>
                    </svg>
                </a>
            </div>
        </header>

        <!-- Hero Section -->
        <section id="home" class="hero-section" style="position: relative;">
            
            <!-- Draggable Assets -->
            <div class="draggable-wrapper layout-right" style="top: 10vh; right: 2vw;">
                <div class="drag-hint">
                    <div class="arrow">----------------&gt;</div>
                    <div class="text">drag &amp; drop</div>
                </div>
                <img src="images/statue.png" class="draggable-asset" alt="Draggable Statue">
            </div>

            <div class="draggable-wrapper layout-left" style="top: 15vh; left: 2vw;">
                <img src="images/asset1.png" class="draggable-asset" alt="Phone Statue">
                <div class="drag-hint">
                    <div class="arrow">&lt;----------------</div>
                    <div class="text">drag &amp; drop</div>
                </div>
            </div>

            <div class="draggable-wrapper layout-left" style="top: 75vh; left: 5vw;">
                <img src="images/asset2.png" class="draggable-asset" alt="Pointing Statue">
                <div class="drag-hint">
                    <div class="arrow">&lt;----------------</div>
                    <div class="text">drag &amp; drop</div>
                </div>
            </div>

            <div class="draggable-wrapper layout-right" style="top: 75vh; right: 5vw;">
                <div class="drag-hint">
                    <div class="arrow">----------------&gt;</div>
                    <div class="text">drag &amp; drop</div>
                </div>
                <img src="images/asset3.png" class="draggable-asset" alt="Chess Piece">
            </div>

            <div class="hero-content">
                <span class="badge" data-translate="hero-badge">FULL STACK DEVELOPER &bull; AI ENTHUSIAST</span>
                <h2 class="hero-title scramble">FIKRI BINTANG PURNOMO</h2>
                <p class="hero-description" data-translate="hero-desc">
                    Building scalable systems, AI-powered applications, and modern web experiences.<br>
                    Informatics Engineering student focused on enterprise software and experimental UI.
                </p>
                <div class="hero-ctas">
                    <a href="#projects" class="cta-button primary" data-translate="btn-projects">[ View Projects ]</a>
                    <a href="Porto Bintang.pdf" target="_blank" class="cta-button secondary" data-translate="btn-print">[ Print Portfolio ]</a>
                    <a href="mailto:fikbintang01@gmail.com" class="cta-button secondary" data-translate="btn-contact">[ Contact Me ]</a>
                </div>
            </div>
        </section>

        <!-- Terminal / About Section -->
        <section id="about" class="grid-section reveal">
            <div class="section-header col-border-right col-span-1">
                <h3 data-translate="about-header">SEE IT IN ACTION</h3>
            </div>
            <div class="terminal-container col-span-3">
                <div class="terminal-window">
                    <div class="terminal-header">
                        <div class="dots">
                            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                        </div>
                        <div class="terminal-tabs">
                            <button class="terminal-tab active" data-mode="intro" data-translate="term-tab-intro">INTRO</button>
                            <button class="terminal-tab" data-mode="qa" data-translate="term-tab-qa">Q&A CLI</button>
                            <button class="terminal-tab" data-mode="activity" data-translate="term-tab-activity">ACTIVITY</button>
                        </div>
                        <span class="terminal-title" data-translate="terminal-title">ABOUT ME</span>
                    </div>
                    <div class="terminal-body" id="terminal-body-intro">
                        <p class="terminal-system-text">> Executing profile fetch...</p>
                        <br>
                        <p class="typewriter-text" id="typewriter"></p>
                    </div>
                    <div class="terminal-body" id="terminal-body-qa" style="display: none;">
                        <div class="terminal-history" id="terminal-history">
                            <p class="terminal-system-text" data-translate="qa-welcome">Welcome to Fikri's Q&A CLI. Type your question or click a suggestion below! Type 'help' for commands.</p>
                        </div>
                        <div class="terminal-suggestions" id="terminal-suggestions">
                            <!-- Dynamic suggestion tags will be rendered here -->
                        </div>
                        <div class="terminal-input-line">
                            <span class="terminal-prompt">guest@fikribintang:~$</span>
                            <input type="text" id="terminal-input" autocomplete="off" placeholder="Type a question or 'help'..." data-translate-placeholder="qa-input-placeholder">
                        </div>
                    </div>
                    <!-- Activity / Heatmap Tab -->
                    <div class="terminal-body" id="terminal-body-activity" style="display: none;">
                        <p class="terminal-system-text" style="margin-bottom: 1rem;" data-translate="activity-desc">> Fetching GitHub contribution history...</p>
                        <div class="heatmap-wrapper">
                            <div class="heatmap-header" style="display: flex; justify-content: space-between; align-items: center;">
                                <div style="display: flex; align-items: center; gap: 1rem;">
                                    <span class="heatmap-title" data-translate="activity-title">CONTRIBUTIONS</span>
                                    <div class="heatmap-stats" style="font-size: 0.8rem;">
                                        <span class="stat-item"><span class="highlight" id="total-contributions-text">0</span> <span data-translate="activity-contribs">Contributions</span></span>
                                    </div>
                                </div>
                                <div class="heatmap-actions">
                                    <select id="heatmap-year-filter" style="background: var(--bg-color); color: var(--text-primary); border: 1px solid var(--border-color); padding: 0.2rem 0.5rem; font-family: var(--font-mono); font-size: 0.8rem; cursor: pointer; outline: none;">
                                        <option value="">Last Year</option>
                                        <option value="2026">2026</option>
                                        <option value="2025">2025</option>
                                        <option value="2024">2024</option>
                                        <option value="2023">2023</option>
                                    </select>
                                </div>
                            </div>
                            <div class="heatmap-scroll">
                                <div class="heatmap-grid" id="heatmap-grid">
                                    <!-- Squares will be generated by JS -->
                                </div>
                            </div>
                            <div class="heatmap-legend">
                                <span data-translate="activity-less">Less</span>
                                <div class="legend-squares">
                                    <div class="heatmap-square" data-level="0"></div>
                                    <div class="heatmap-square" data-level="1"></div>
                                    <div class="heatmap-square" data-level="2"></div>
                                    <div class="heatmap-square" data-level="3"></div>
                                    <div class="heatmap-square" data-level="4"></div>
                                </div>
                                <span data-translate="activity-more">More</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="projects" class="grid-section projects-section reveal" style="overflow: hidden;">
            <div class="section-header col-border-right col-span-1">
                <h3 data-translate="projects-header">PROJECTS</h3>
                <div class="slider-controls">
                    <button class="slider-btn prev-btn" title="Previous Project">&lt;</button>
                    <button class="slider-btn next-btn" title="Next Project">&gt;</button>
                </div>
            </div>
            <div class="projects-slider-container col-span-3">
                <div class="projects-track">

                    <!-- Project 1 -->
                    <div class="project-card" data-project="jurnal-ku">
                        <div class="glitch-wrapper">
                            <div class="scanlines"></div>
                            <img src="images/project1.png" alt="JURNAL KU" class="glitch-image">
                        </div>
                        <h4>JURNAL KU</h4>
                        <p data-translate="proj-1-desc">A comprehensive digital library and journal search engine designed for academics and
                            researchers to discover peer-reviewed publications efficiently.</p>
                        <div class="project-tags">
                            <span class="project-tag">React</span>
                            <span class="project-tag">Node.js</span>
                            <span class="project-tag">Vercel</span>
                        </div>
                        <a href="https://dejurnal.vercel.app/" target="_blank" class="project-btn" data-translate="btn-view-project">VIEW PROJECT â†—</a>
                    </div>

                    <!-- Project 2 -->
                    <div class="project-card" data-project="kiise-coffee">
                        <div class="glitch-wrapper">
                            <div class="scanlines"></div>
                            <img src="images/project2.png" alt="KIISE COFFEE" class="glitch-image">
                        </div>
                        <h4>KIISE COFFEE</h4>
                        <p data-translate="proj-2-desc">A modern e-commerce platform for an artisanal cafe, featuring an intuitive online ordering
                            system and interactive menu for coffee enthusiasts.</p>
                        <div class="project-tags">
                            <span class="project-tag">HTML</span>
                            <span class="project-tag">CSS</span>
                            <span class="project-tag">JavaScript</span>
                        </div>
                        <a href="https://kiisecoff.ti24se1.my.id/" target="_blank" class="project-btn" data-translate="btn-view-project">VIEW PROJECT â†—</a>
                    </div>

                    <!-- Project 3 -->
                    <div class="project-card" data-project="marimacha">
                        <div class="glitch-wrapper">
                            <div class="scanlines"></div>
                            <img src="images/project3.png" alt="MARIMACHA" class="glitch-image">
                        </div>
                        <h4>MARIMACHA</h4>
                        <p data-translate="proj-3-desc">A specialized online storefront for premium matcha products, highlighting seamless checkout
                            and visually appealing product displays.</p>
                        <div class="project-tags">
                            <span class="project-tag">CodeIgniter 3</span>
                            <span class="project-tag">Supabase</span>
                            <span class="project-tag">MySQL</span>
                        </div>
                        <a href="https://marimatcha.vercel.app/" target="_blank" class="project-btn" data-translate="btn-view-project">VIEW PROJECT â†—</a>
                    </div>

                    <!-- Project 4 -->
                    <div class="project-card" data-project="fkkmbt">
                        <div class="glitch-wrapper">
                            <div class="scanlines"></div>
                            <img src="images/project4.png" alt="FKKMBT" class="glitch-image">
                        </div>
                        <h4>FKKMBT</h4>
                        <p data-translate="proj-4-desc">A robust community management system for Bukit Tiara residents, streamlining data
                            administration, announcements, and residential services.</p>
                        <div class="project-tags">
                            <span class="project-tag">PHP</span>
                            <span class="project-tag">MySQL</span>
                            <span class="project-tag">Bootstrap</span>
                        </div>
                        <a href="https://fkkmbt.ti24se1.my.id/" target="_blank" class="project-btn" data-translate="btn-view-project">VIEW PROJECT â†—</a>
                    </div>

                    <!-- Project 5: MOBILKU -->
                    <div class="project-card" data-project="mobilku">
                        <div class="glitch-wrapper">
                            <div class="scanlines"></div>
                            <img src="images/project_mobilku.png" alt="MOBILKU" class="glitch-image">
                        </div>
                        <h4>MOBILKU</h4>
                        <p data-translate="proj-5-desc">An integrated web-based platform for buying and selling cars, featuring an interactive vehicle catalog, customer offering system, delivery monitoring, and a comprehensive admin panel for transactions and report generation.</p>
                        <div class="project-tags">
                            <span class="project-tag">CodeIgniter 3</span>
                            <span class="project-tag">MySQL</span>
                            <span class="project-tag">Bootstrap</span>
                        </div>
                        <a href="https://github.com/FikriBintangx" target="_blank" class="project-btn" data-translate="btn-view-project">VIEW PROJECT â†—</a>
                    </div>

                    <!-- Project 6: OURSCONTENT -->
                    <div class="project-card" data-project="ourscontent">
                        <div class="glitch-wrapper">
                            <div class="scanlines"></div>
                            <img src="images/project_ourscontent.png" alt="OURSCONTENT" class="glitch-image">
                        </div>
                        <h4>OURSCONTENT</h4>
                        <p data-translate="proj-6-desc">A content management system (CMS) and creator performance dashboard built for a Semester 4 Object-Oriented Programming (PBO) project, enabling account administration, platform metrics, and reporting.</p>
                        <div class="project-tags">
                            <span class="project-tag">Java Swing</span>
                            <span class="project-tag">FlatLaf</span>
                            <span class="project-tag">PostgreSQL</span>
                        </div>
                        <a href="https://github.com/FikriBintangx" target="_blank" class="project-btn" data-translate="btn-view-project">VIEW PROJECT â†—</a>
                    </div>

                </div>
            </div>
        </section>

        <!-- Skills Grid Section -->
        <section id="skills" class="grid-section feature-section reveal">
            <div class="section-title-full">
                <h3 data-translate="skills-header">SKILLS & EXPERIENCE</h3>
            </div>
            <div class="feature-grid">
                <div class="feature-card">
                    <h4 data-translate="skill-prog-title">PROGRAMMING & DEV</h4>
                    <p data-translate="skill-prog-desc">Flutter, Java, HTML, CSS, JavaScript, REST API Integration</p>
                </div>
                <div class="feature-card">
                    <h4 data-translate="skill-db-title">DATABASES & TOOLS</h4>
                    <p data-translate="skill-db-desc">MySQL, MariaDB, PostgreSQL, Git & GitHub, Figma</p>
                </div>
                <div class="feature-card">
                    <h4 data-translate="skill-soft-title">SOFT SKILLS</h4>
                    <p data-translate="skill-soft-desc">Problem Solving, Crisis Management, Creative Thinking, Data Analysis, Strategic Planning</p>
                </div>
                <div class="feature-card">
                    <h4>ID EXPRESS</h4>
                    <p data-translate="skill-job1-desc">Delivery Administration Staff (2022 - 2024). Managed shipment data, tracking information, and
                        monitored delivery operations.</p>
                </div>
                <div class="feature-card">
                    <h4>PT.SURYA SHUENN YUEHH</h4>
                    <p data-translate="skill-job2-desc">Machine Operator (2024 - 2025). Operated manufacturing machines, ensured product quality, and
                        maintained workplace safety.</p>
                </div>
                <div class="feature-card">
                    <h4>RESTAURANT OPERATIONS</h4>
                    <p data-translate="skill-job3-desc">Customer Service & Operations (2025 - 2026). Assisted in food preparation, customer service, and
                        maintained cleanliness.</p>
                </div>
            </div>
        </section>

        <!-- Location / Map Section -->
        <section id="location" class="grid-section reveal">
            <div class="section-title-full" style="border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; margin-bottom: 0;">
                <h3 data-translate="location-header">LOCATION</h3>
            </div>
            <div class="map-wrapper col-span-4" style="width: 100%; height: 400px; position: relative;">
                <div id="map-container" style="width: 100%; height: 100%;"></div>
                <div class="map-overlay-text">
                    <span class="pulse-dot"></span> BASED IN INDONESIA
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="grid-footer">
            <div class="col-border-right"><span class="footer-text">FIKRI BINTANG PURNOMO PORTFOLIO</span></div>
            <div class="col-border-right"><span class="footer-text v-text">v1.0.0</span></div>
            <div class="col-border-right"><a href="CV.pdf" target="_blank" class="footer-link" data-translate="footer-cv">PRINT CV â†—</a></div>
            <div class="col-border-right"><a href="Porto Bintang.pdf" class="footer-link" data-translate="footer-porto">PORTFOLIO
                    â†—</a></div>
            <div><span class="footer-text">2026</span></div>
        </footer>
    </div>

    <!-- Project Detail Modal -->
    <div id="project-modal" class="modal">
        <div class="modal-content">
            <span class="modal-close">&times;</span>
            <div class="modal-grid">
                <div class="modal-left">
                    <div id="modal-gallery" class="modal-gallery">
                        <!-- Images will be inserted here dynamically -->
                    </div>
                </div>
                <div class="modal-right">
                    <h3 id="modal-title" class="scramble" style="font-size: 2rem; margin-bottom: 0.5rem; font-family: var(--font-mono);">PROJECT TITLE</h3>
                    <div id="modal-tags" class="project-tags" style="margin-bottom: 1.5rem;">
                        <!-- Tags will be inserted here dynamically -->
                    </div>
                    <div id="modal-description" class="modal-description">
                        <!-- Description will be inserted here dynamically -->
                    </div>
                    <div class="modal-actions">
                        <a id="modal-link" href="#" target="_blank" class="cta-button primary">[ VISIT PROJECT ]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PDF Viewer Modal -->
    <div id="pdf-modal" class="modal">
        <div class="modal-content pdf-modal-content">
            <span class="modal-close pdf-modal-close">&times;</span>
            <div class="pdf-modal-header">
                <h3 id="pdf-modal-title" style="font-family: var(--font-mono); margin: 0; font-size: 1.5rem;" data-translate="pdf-viewer-title">PDF VIEWER</h3>
                <a id="pdf-download-btn" href="#" download class="cta-button primary" style="font-size: 0.8rem; padding: 0.5rem 1rem;" data-translate="pdf-download">[ DOWNLOAD PDF ]</a>
            </div>
            <div class="pdf-frame-container">
                <iframe id="pdf-iframe" src="" frameborder="0" style="width: 100%; height: 100%; border: 1px solid var(--border-color); background: white;"></iframe>
            </div>
        </div>
    </div>

    <!-- Leaflet JS for Map -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="../scripts/main.js"></script>
</body>

</html>
